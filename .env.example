# ---------------------------------------------------------------------------
# SchoolOS environment template. Copy to `.env` and fill in real values.
# Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Supabase / Neon / local).
#
# For a hosted database, ask for certificate verification explicitly —
# node-postgres verifies regardless, and spelling it out avoids a warning on
# every start:
#   postgresql://user:password@host/db?sslmode=verify-full
DATABASE_URL="postgresql://user:password@localhost:5432/schoolos_dev?schema=public"

# Secret used to sign session cookies. Generate with:
#   openssl rand -base64 48
SESSION_SECRET="replace-me-with-a-long-random-value-at-least-32-chars"

# Public origin of the deployment, used for absolute URLs and cookie scope.
APP_URL="http://localhost:3000"

# Outbound email goes through Resend. Without a key, messages are written to
# the server log instead — see src/server/mail/mailer.ts.
#
# Until a domain is verified at resend.com/domains, Resend delivers only to the
# address that owns the account, and MAIL_FROM must stay onboarding@resend.dev.
# That is why a "forgot password" test to your own inbox can work while
# activation emails to teachers, parents and staff do not: verify a domain and
# set MAIL_FROM to an address on it (e.g. "SchoolOS <no-reply@yourschool.in>").
# EMAIL_FROM is accepted as another name for MAIL_FROM.
RESEND_API_KEY=""
MAIL_FROM="SchoolOS <onboarding@resend.dev>"

# Or send through any SMTP server instead (used when HOST, USER and PASSWORD
# are all set). For Gmail, SMTP_PASSWORD is a 16-letter App Password from
# Google Account → Security → 2-Step Verification → App passwords — the normal
# account password is refused. Gmail sends from SMTP_USER (~500 mails a day).
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="yourschool@gmail.com"
# SMTP_PASSWORD="abcdefghijklmnop"
# SMTP_FROM_EMAIL=""

# Where uploaded lesson PDFs are stored on disk (default ./uploads). Must be
# persistent storage in production, and never inside public/.
# UPLOAD_DIR="/var/lib/schoolos/uploads"

# Platform owner's contact details for the public /contact page. New
# enquiries are emailed to PLATFORM_CONTACT_EMAIL as well.
# PLATFORM_CONTACT_EMAIL="hello@schoolos.in"
# PLATFORM_CONTACT_PHONE="+91 98765 43210"

# Node environment: development | test | production
NODE_ENV="development"

# Scheduled jobs (/api/cron/*). Optional; at least 16 characters.
# CRON_SECRET=""
