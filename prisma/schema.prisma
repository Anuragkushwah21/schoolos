// =============================================================================
// SchoolOS — multi-tenant school management platform
// =============================================================================
//
// TENANCY CONTRACT — every school-owned model obeys all three rules:
//
//   1. It carries a `schoolId` column.
//   2. It declares `@@unique([schoolId, id])`.
//   3. Every relation to another school-owned model is a COMPOSITE foreign key
//      on `(schoolId, <parentId>) -> (schoolId, id)`.
//
// Rule 3 is what makes cross-tenant data physically impossible: PostgreSQL
// rejects a row that links records belonging to two different schools, so a
// forgotten `where: { schoolId }` is a read bug rather than a data breach.
//
// DELETION POLICY
//
//   * `School` relations cascade — deleting a school removes everything it owns.
//   * Intra-tenant relations use NoAction, which blocks deleting a parent that
//     still has children (you cannot drop a Class that has Sections) while
//     still allowing a whole-school cascade to remove parent and child in the
//     same statement. `Restrict` would fire spuriously during that cascade
//     because it is checked immediately rather than at end of statement.
//
// Schools and people are normally deactivated via `status`, not deleted.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  /// Academic leadership and oversight of one school: sees the school's
  /// attendance, exams, results, staff and reports, read-only. Not a second
  /// School Admin — admissions, fees, payroll, settings and users stay with
  /// the School Admin (see lib/permissions.ts).
  PRINCIPAL
  TEACHER
  STUDENT
  PARENT
  /// Office, accounts, transport, library and support staff. A school member
  /// with a login but none of the School Admin's powers: they see their own
  /// record, notices and meetings, plus any module the admin grants through
  /// `StaffMember.permissions`.
  NON_TEACHING_STAFF
}

/// PENDING -> UNDER_REVIEW -> ACTIVE (approved) | REJECTED.
/// An ACTIVE school may later become SUSPENDED or INACTIVE.
enum SchoolStatus {
  PENDING
  UNDER_REVIEW
  ACTIVE
  REJECTED
  SUSPENDED
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

/// Where a student stands with the school. ACTIVE and ON_LEAVE are current
/// students; the rest have left, and their records are kept as history.
enum StudentStatus {
  ACTIVE
  INACTIVE
  TRANSFERRED
  GRADUATED
  ON_LEAVE
  WITHDRAWN
}

/// Status of one student's placement within one academic session.
enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  TRANSFERRED
  WITHDRAWN
}

/// Employment status, shared by teachers and non-teaching staff. ACTIVE and
/// ON_LEAVE are current employees; SUSPENDED keeps the job but not the login;
/// the rest have left, and their records are kept as history.
enum TeacherStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  SUSPENDED
  RESIGNED
  TERMINATED
  RETIRED
  TRANSFERRED
}

/// Why a login is switched off. The person's status and their login are
/// separate: a login closed by a status change (STATUS) reopens when they
/// return; one closed by the School Admin (ADMIN) stays closed until reopened.
enum LoginDisabledReason {
  ADMIN
  STATUS
}

/// Who first raised a student's need for support.
enum SupportSource {
  TEACHER
  PARENT
  SCHOOL_ADMIN
}

enum SupportPriority {
  LOW
  MEDIUM
  HIGH
}

/// Where a support record stands. Kept short on purpose: this is help for a
/// child, not a case file.
enum SupportStatus {
  NEW
  REVIEWING
  SUPPORT_PLANNED
  IN_PROGRESS
  IMPROVING
  RESOLVED
}

/// Why a student needs support — descriptive, never a label on the child.
enum SupportReason {
  DIFFICULTY_UNDERSTANDING
  LOW_TEST_PERFORMANCE
  HOMEWORK_INCOMPLETE
  LOW_PARTICIPATION
  ATTENDANCE
  NEEDS_PRACTICE
  NEEDS_REVISION
  LEARNING_GAP
  PARENT_CONCERN
  OTHER
}

enum SupportAction {
  EXTRA_PRACTICE
  STUDY_MATERIAL
  REVISION
  EXTRA_CLASS
  ONE_TO_ONE
  HOMEWORK_SUPPORT
  PARENT_DISCUSSION
  MONITOR
  OTHER
}

/// Where a parent–teacher concern stands. OPEN → IN_PROGRESS → RESOLVED →
/// CLOSED; a closed concern takes no more replies.
enum ConcernStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

/// What a concern is about — descriptive, never a label on the child.
enum ConcernType {
  ACADEMIC
  TOPIC_DIFFICULTY
  HOMEWORK
  ATTENDANCE
  PARTICIPATION
  EXTRA_SUPPORT
  IMPROVEMENT_SUGGESTION
  POSITIVE_FEEDBACK
  OTHER
}

/// Whose status a `StatusChange` records.
enum PersonKind {
  STUDENT
  PARENT
  TEACHER
  STAFF
}

/// What changed: the person's status, or their login access.
enum StatusChangeKind {
  STATUS
  LOGIN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  /// On approved leave (shown as "Leave").
  EXCUSED
  /// Present for part of the day; counts as half a day attended.
  HALF_DAY
}

/// When in the day a school takes its daily register.
enum RegisterTiming {
  FIRST_PERIOD
  LAST_PERIOD
}

/// AUTO: a saved draft submits itself when the attendance period ends.
/// MANUAL: the teacher presses Submit.
enum RegisterSubmission {
  AUTO
  MANUAL
}

/// DRAFT: marks saved as the teacher works, not yet the official record.
/// SUBMITTED: the official record — the teacher may correct it until
/// `correctionDeadline`, the School Admin at any time.
enum RegisterStatus {
  DRAFT
  SUBMITTED
}

enum TeacherAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  ON_LEAVE
}

/// A public admission application, child by child:
/// SUBMITTED → UNDER_REVIEW → SHORTLISTED → APPROVED → CONVERTED (or REJECTED).
enum AdmissionStatus {
  /// Being filled in by a teacher in an admission drive; the office does not act on it yet.
  DRAFT
  /// Sent back to the teacher by the School Admin to fix; resubmitted from here.
  CORRECTION_REQUESTED
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  APPROVED
  REJECTED
  CONVERTED
}

enum NoticeAudience {
  ALL
  TEACHERS
  STUDENTS
  PARENTS
  NON_TEACHING_STAFF
}

/// Who a notice is addressed to within the audience: the whole school, one
/// class, one section, or a hand-picked list of students (and, with the
/// PARENTS audience, their guardians).
enum NoticeScope {
  SCHOOL
  CLASS
  SECTION
  STUDENTS
  /// Everyone in one stream (Science, Commerce…) across the school.
  STREAM
}

/// What kind of message a notice is, in the Communication Center. One table:
/// an announcement and an emergency alert are notices with a different weight.
enum NoticeKind {
  NOTICE
  ANNOUNCEMENT
  /// Urgent: also raised as a critical notification for everyone it reaches.
  EMERGENCY
}

enum NoticeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// A draft is the teacher's own; only PUBLISHED homework is work a class has
/// actually been set.
enum HomeworkStatus {
  DRAFT
  PUBLISHED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

/// Lifecycle of a single timetabled period on a specific date.
///
/// SCHEDULED is the absence of a record: the timetable says the period exists
/// and nobody has written it up yet. The rest are what the teacher who took it
/// — or the substitute who stood in — recorded afterwards.
enum ClassSessionStatus {
  SCHEDULED
  COMPLETED
  SUBSTITUTE
  REMOTE
  MISSED
  CANCELLED
}

/// A teacher's structured read on one child, kept to fixed bands rather than
/// free prose so a parent sees the same three questions answered every time —
/// and so nothing beyond those bands is ever put on a child's record.
enum RemarkLevel {
  GOOD
  AVERAGE
  NEEDS_ATTENTION
}

enum HomeworkHabit {
  REGULAR
  SOMETIMES_MISSING
  FREQUENTLY_MISSING
}

enum ParticipationLevel {
  ACTIVE
  AVERAGE
  NEEDS_IMPROVEMENT
}

enum PlanTier {
  STARTER
  STANDARD
  PRO
}

enum PlanStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BillingPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum FeatureRequestStatus {
  SUBMITTED
  NEEDS_INFO
  UNDER_EVALUATION
  APPROVED
  IN_DEVELOPMENT
  TESTING
  RELEASED
  DECLINED
}

enum FeatureRequestPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// What a released custom feature becomes — decided by the Super Admin, never
/// implied by the requester's plan.
enum FeatureReleaseScope {
  CUSTOMER_SPECIFIC
  OPTIONAL_MODULE
  STANDARD_FEATURE
  PREMIUM_ADDON
}

/// An exam's results are hidden from students and parents until it is
/// PUBLISHED. Only the School Admin publishes.
enum ExamStatus {
  DRAFT
  PUBLISHED
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
  MATERNITY
  PATERNITY
  UNPAID
  OTHER
}

/// PENDING until the School Admin decides. A teacher may cancel a pending
/// request, or an approved one that has not started yet.
enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// The only status a meeting stores. Whether a SCHEDULED meeting is
/// upcoming, ongoing or completed follows from its date and times and is
/// worked out on every read (`meetingStatus` in `lib/time-status.ts`), so it
/// never has to be flipped by hand. CANCELLED is the office's decision and wins.
enum MeetingStatus {
  SCHEDULED
  CANCELLED
}

/// What kind of meeting it is — a label for lists and filters. Who is invited
/// is `audiences` + `scope`, not this.
enum MeetingType {
  PTM
  GENERAL
}

/// A parent's optional answer to a PTM invitation. No answer = not responded.
enum PtmResponse {
  WILL_ATTEND
  UNABLE_TO_ATTEND
}

/// What actually happened, recorded by a teacher after the PTM — separate
/// from what the parent said beforehand.
enum PtmAttendance {
  ATTENDED
  DID_NOT_ATTEND
  RESCHEDULED
}

/// A group of people a meeting is for. ALL stands for every group, including
/// ones added later; it is stored alone rather than alongside the others.
enum MeetingAudience {
  ALL
  PARENTS
  STUDENTS
  TEACHERS
  NON_TEACHING_STAFF
}

/// How far a meeting reaches within its audiences: the whole school, the
/// families and teachers of chosen sections, or hand-picked people.
enum MeetingScope {
  SCHOOL
  SECTIONS
  PEOPLE
}

enum ComplaintCategory {
  ACADEMIC
  FEES
  TRANSPORT
  FACILITIES
  STAFF
  BULLYING
  HEALTH
  OTHER
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

/// Non-teaching staff. Teachers stay in `Teacher`, which carries their login.
enum StaffRole {
  ACCOUNTANT
  RECEPTIONIST
  LIBRARIAN
  DRIVER
  TRANSPORT_ATTENDANT
  PEON
  OFFICE_STAFF
  COORDINATOR
  SECURITY
  LAB_ASSISTANT
  OTHER
}

/// Modules a School Admin can open to one non-teaching staff member. Every
/// grant is read-only for now; a designation never implies any of them.
enum StaffPermission {
  VIEW_STUDENTS
  VIEW_LIBRARY
  VIEW_TRANSPORT
  /// Issue and return books, add books, collect fines.
  MANAGE_LIBRARY
  /// Record fee payments and print receipts; see who owes what.
  COLLECT_FEES
}

enum VehicleType {
  BUS
  VAN
  CAR
  OTHER
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum TransportStatus {
  ACTIVE
  SUSPENDED
}

enum AssetCategory {
  COMPUTER
  FURNITURE
  PROJECTOR
  LAB_EQUIPMENT
  SPORTS
  STATIONERY
  OTHER
}

enum AssetStatus {
  ACTIVE
  IN_REPAIR
  DAMAGED
  LOST
  DISPOSED
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

/// What a teacher attached to a lesson. `LINK` and `DOCUMENT` carry a URL;
/// `NOTES`, `QUESTIONS` and `PRACTICE` carry text the teacher typed. There is no
/// upload pipeline in V1, so a document is a URL the school already hosts.
enum LessonMaterialKind {
  NOTES
  LINK
  DOCUMENT
  QUESTIONS
  PRACTICE
  VIDEO
}

/// What a school spends money on. A fixed list rather than a table: the
/// breakdown chart compares schools' own months against each other, and a
/// free-text category would split "Electricity" from "electricity bill".
enum ExpenseCategory {
  ELECTRICITY
  RENT
  STATIONERY
  MAINTENANCE
  TRANSPORT
  EVENTS
  EQUIPMENT
  INTERNET
  OTHER
}

/// How a salary is expressed. Only MONTHLY is used today; the others exist so a
/// school that pays hourly staff does not need a migration to say so.
enum SalaryType {
  MONTHLY
  ANNUAL
  HOURLY
}

/// How a fee payment reached the school. `OTHER` covers whatever a school does
/// that this list does not — the point is a record, not a taxonomy.
enum PaymentMethod {
  CASH
  CHEQUE
  BANK_TRANSFER
  UPI
  CARD
  OTHER
}

enum MediaCategory {
  GALLERY
  BANNER
  LOGO
  DOCUMENT
}

/// Why a one-time code was issued. Only registration needs one today; the
/// column exists so password resets and email changes can reuse the table
/// without a migration that rewrites history.
enum VerificationPurpose {
  SCHOOL_REGISTRATION
}

/// What an API token may do. READ tokens are refused on every write, so a
/// token handed to a reporting script cannot change a record even if it leaks.
enum ApiTokenScope {
  READ
  FULL
}

enum ParentRelationship {
  FATHER
  MOTHER
  GUARDIAN
}

// =============================================================================
// PLATFORM LEVEL — not owned by any single school
// =============================================================================

/// Authentication identity. One row per person who can sign in.
///
/// `schoolId` is null only for SUPER_ADMIN; every other role is bound to
/// exactly one school, and that column — never the URL or request body — is
/// the authoritative source of a user's tenant.
///
/// Email is globally unique so that sign-in needs only an email and password,
/// with no school picker. One person staffing two schools needs two accounts.
model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  passwordHash       String
  /// Set on a seeded or issued default password: the person must choose
  /// their own before using SchoolOS (see server/auth/current-user.ts).
  mustChangePassword Boolean              @default(false)
  role               UserRole
  firstName          String
  lastName           String
  phone              String?
  isActive           Boolean              @default(true)
  /// Interface language chosen by this person ("en", "hi"). Null means "not
  /// chosen", and the browser cookie or English applies. Checked against
  /// `lib/i18n/config.ts#LOCALES` on read, so an unknown value is ignored.
  preferredLanguage  String?              @db.VarChar(10)
  /// Set with `isActive = false`: who closed the login and when. Null while
  /// the login is open.
  disabledReason     LoginDisabledReason?
  disabledAt         DateTime?
  lastLoginAt        DateTime?
  /// Notifications are derived from school data, not stored. "Mark all as
  /// read" records this moment; alerts from before it count as read.
  alertsReadAt       DateTime?
  /// Set when the person chose their own password from the activation email.
  /// Null = provisioned by the school, waiting for activation (cannot sign in).
  activatedAt        DateTime?
  /// Keys of alerts read one at a time since `alertsReadAt`. Pruned to the
  /// alerts still showing whenever it is written, so it stays short.
  readAlertKeys      String[]             @default([])
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  sessions               Session[]
  ownedOrganization      Organization?         @relation("OrganizationOwner")
  campusRequests         CampusRequest[]       @relation("CampusRequester")
  featureRequests        FeatureRequest[]      @relation("FeatureRequester")
  featureRequestEvents   FeatureRequestEvent[] @relation("FeatureRequestActor")
  planRequests           PlanChangeRequest[]   @relation("PlanRequester")
  planRequestsReviewed   PlanChangeRequest[]   @relation("PlanReviewer")
  campusRequestsReviewed CampusRequest[]       @relation("CampusReviewer")
  apiTokens              ApiToken[]
  teacher                Teacher?
  student                Student?
  parent                 Parent?
  staffMember            StaffMember?

  auditLogs                    AuditLog[]             @relation("AuditActor")
  reviewedSchools              School[]               @relation("SchoolReviewer")
  reviewedAdmissions           AdmissionApplication[] @relation("AdmissionReviewer")
  authoredNotices              Notice[]               @relation("NoticeAuthor")
  markedAttendance             StudentAttendance[]    @relation("AttendanceMarker")
  recordedSalaries             TeacherSalary[]        @relation("SalaryRecorder")
  recordedPayments             FeePayment[]           @relation("PaymentRecorder")
  voidedPayments               FeePayment[]           @relation("PaymentVoider")
  recordedExpenses             Expense[]              @relation("ExpenseRecorder")
  recordedSalaryPays           SalaryPayment[]        @relation("SalaryPaymentRecorder")
  reviewedLeave                LeaveRequest[]         @relation("LeaveReviewer")
  raisedComplaints             Complaint[]            @relation("ComplaintRaiser")
  assignedComplaints           Complaint[]            @relation("ComplaintAssignee")
  issuedBooks                  BookIssue[]            @relation("BookIssuer")
  substitutionsCreated         StaffSubstitution[]    @relation("SubstitutionCreator")
  substitutionsEnded           StaffSubstitution[]    @relation("SubstitutionEnder")
  tripsMarked                  TransportTripLog[]     @relation("TripMarker")
  transportIssues              TransportIssue[]       @relation("TransportIssueReporter")
  returnedBooks                BookIssue[]            @relation("BookReturner")
  studentLeavesRequested       StudentLeave[]         @relation("StudentLeaveRequester")
  studentLeavesDecided         StudentLeave[]         @relation("StudentLeaveDecider")
  studentLeavesTeacherReviewed StudentLeave[]         @relation("StudentLeaveTeacherReviewer")
  assetEvents                  AssetEvent[]           @relation("AssetEventActor")
  createdMeetings              Meeting[]              @relation("MeetingCreator")
  statusChanges                StatusChange[]         @relation("StatusChanger")
  createdSupports              StudentSupport[]       @relation("SupportCreator")
  supportNotes                 SupportNote[]          @relation("SupportNoteAuthor")
  concernsCreated              SupportConcern[]       @relation("ConcernCreator")
  concernMessages              ConcernMessage[]       @relation("ConcernMessageAuthor")
  meetingInvites               MeetingRecipient[]

  /// Lets school-owned rows point at a user with a composite key, so a link
  /// to another school's user is rejected by the database.
  submittedRegisters     AttendanceRegister[] @relation("RegisterSubmitter")
  assignedRegisterCovers RegisterCover[]      @relation("RegisterCoverAssigner")
  assignedWorkCovers     WorkCover[]          @relation("WorkCoverAssigner")

  markedStaffAttendance StaffAttendance[] @relation("StaffAttendanceMarker")

  accountTokens AccountToken[]
  noticeReads   NoticeRead[]

  admissionFollowUps     AdmissionFollowUp[] @relation("AdmissionFollowUpAuthor")
  concessionsApproved    FeeConcession[]     @relation("ConcessionApprover")
  familyPaymentsRecorded FamilyPayment[]     @relation("FamilyPaymentRecorder")
  carryForwardsCreated   FeeCarryForward[]   @relation("CarryForwardCreator")

  enquiriesCreated      Enquiry[]            @relation("EnquiryCreator")
  enquiriesUpdated      Enquiry[]            @relation("EnquiryUpdater")
  enquiriesAssigned     Enquiry[]            @relation("EnquiryAssignee")
  enquiryFeesAgreed     Enquiry[]            @relation("EnquiryFeeAgreer")
  enquiryChildrenAdded  EnquiryChild[]       @relation("EnquiryChildCreator")
  enquiryChildrenEdited EnquiryChild[]       @relation("EnquiryChildUpdater")
  enquiryFollowUps      EnquiryFollowUp[]    @relation("EnquiryFollowUpAuthor")
  enquiryFeeRevisions   EnquiryFeeRevision[] @relation("EnquiryFeeReviser")
  admissionPortalEdits  AdmissionPortal[]    @relation("AdmissionPortalEditor")
  visitorsRecorded      Visitor[]            @relation("VisitorRecorder")
  responsibilitiesHeld  Responsibility[]     @relation("ResponsibilityAssignee")
  responsibilitiesGiven Responsibility[]     @relation("ResponsibilityAssigner")

  @@unique([schoolId, id])
  @@index([schoolId, role])
  @@index([role])
}

/// Server-side session. The cookie carries an opaque random token; only its
/// SHA-256 hash is stored, so a database leak does not yield usable sessions.
///
/// Sessions are rows rather than JWTs because they must be revocable: when a
/// Super Admin suspends a school, every session belonging to it is deleted and
/// the next request fails. A stateless token cannot be withdrawn early.
model Session {
  id             String   @id @default(cuid())
  tokenHash      String   @unique
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  ipAddress      String?
  userAgent      String?
  /// The campus an Owner switched to. Checked on every request against the
  /// organization they own; anything else falls back to the user's own school.
  activeSchoolId String?

  @@index([userId])
  @@index([expiresAt])
}

/// A bearer token for the REST API.
///
/// A token *acts as the user who created it*: it carries no role of its own, so
/// it can never do more than that person could, and deactivating them — or
/// suspending their school — kills the token on its next request. Only the
/// SHA-256 hash is stored; `prefix` exists so a token can be recognised in a
/// list without being reconstructible.
///
/// `schoolId` is denormalised from the owner so tokens can be listed and
/// scoped per school; it is null for platform (SUPER_ADMIN) tokens.
model ApiToken {
  id        String        @id @default(cuid())
  name      String
  tokenHash String        @unique
  prefix    String
  scope     ApiTokenScope @default(READ)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([schoolId, createdAt])
  @@index([userId])
}

/// A one-time code sent to an email address to prove the recipient owns it.
///
/// Only the code's hash is stored, and a row carries its own attempt counter
/// so a six-digit code cannot be ground down: five wrong guesses and the code
/// is dead, whoever is guessing. Codes expire quickly and are consumed on use.
model EmailVerification {
  id       String              @id @default(cuid())
  email    String
  purpose  VerificationPurpose @default(SCHOOL_REGISTRATION)
  codeHash String

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  lastSentAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([schoolId, purpose])
  @@index([email, purpose])
  @@index([expiresAt])
}

/// A tenant. Also serves as the registration request: a submitted registration
/// is a School row with status PENDING, which avoids a second entity that has
/// to be kept in sync with the school it becomes.
model School {
  id     String       @id @default(cuid())
  slug   String       @unique
  status SchoolStatus @default(PENDING)

  /// The optional modules this school has (see lib/school-modules.ts): copied
  /// from its plan on approval and on a plan change, unless the Super Admin
  /// adjusted them for this school (`modulesCustomized`).
  optionalModules   String[] @default(["FINANCE", "EXPENSES", "PAYROLL", "LIBRARY", "TRANSPORT", "INVENTORY"])
  modulesCustomized Boolean  @default(false)

  /// A Live Demo sandbox: fictional data for one website visitor, deleted
  /// after `demoExpiresAt`. Never a real school — hidden from the platform's
  /// lists and reports and from public school pages, and it sends no email.
  isDemo        Boolean   @default(false)
  demoExpiresAt DateTime?

  /// The optional roles this campus may use (see lib/school-roles.ts): copied
  /// from its plan, unless the Super Admin adjusted them (`rolesCustomized`).
  /// Core roles (School Admin, Teacher, Parent, Student) are always available.
  enabledRoles    String[] @default(["PRINCIPAL", "ACCOUNTANT", "RECEPTIONIST", "LIBRARIAN", "DRIVER", "TRANSPORT_ATTENDANT", "PEON", "OFFICE_STAFF", "COORDINATOR", "SECURITY", "LAB_ASSISTANT", "OTHER"])
  rolesCustomized Boolean  @default(false)
  /// Per-campus limits that override the plan's (key → maximum), e.g.
  /// {"STUDENTS": 500, "PRINCIPAL": 1}. Keys: LIMIT_KEYS in lib/school-roles.ts.
  roleLimits      Json?

  /// The Owner/Organization this campus belongs to. Every school has one
  /// (backfilled 8 Oct 2026); a single-school owner has exactly one campus.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  /// Reserved for the subdomain and custom-domain stages. Both are nullable
  /// and unique, so they can be populated per school without a migration.
  subdomain    String? @unique
  customDomain String? @unique

  name      String
  shortName String?

  // --- registration contact (the person who applied) ---
  contactName  String
  contactEmail String
  contactPhone String

  // --- public profile ---
  about            String?
  principalName    String?
  principalMessage String?
  establishedYear  Int?
  /// The government UDISE+ code (11 digits) that identifies an Indian school.
  /// Optional — a new or unrecognised school may not have one yet.
  udiseCode        String? @unique
  affiliationBoard String?

  // --- contact details shown on the public site ---
  email       String?
  phone       String?
  addressLine String?
  city        String?
  state       String?
  postalCode  String?
  country     String  @default("India")

  // --- branding ---
  logoUrl        String?
  faviconUrl     String?
  bannerUrl      String?
  primaryColor   String  @default("#1e40af")
  secondaryColor String  @default("#f59e0b")

  /// Days of the week the school is normally closed. Attendance is not
  /// expected on them, but may still be recorded for a special working day.
  weeklyOffDays DayOfWeek[] @default([SUNDAY])

  // --- fee receipts ---
  /// Printed under the school's name on every fee receipt, e.g. the board
  /// affiliation or registration number.
  receiptHeaderNote          String?
  /// Printed at the foot of every fee receipt, e.g. "Fees once paid are not
  /// refundable."
  receiptFooterNote          String?
  /// Library fine per day overdue, in paise. Zero means no fines.
  libraryFinePerDayMinor     Int     @default(200)
  /// Default loan period for a new issue, in days.
  libraryLoanDays            Int     @default(14)
  /// Books a borrower may hold at once.
  libraryMaxLoans            Int     @default(3)
  /// The last copy number issued (BK-0001, BK-0002, …).
  lastBookCopyNumber         Int     @default(0)
  /// How many days back a student leave request may start. 0: from today only.
  studentLeaveBackdateDays   Int     @default(7)
  /// Retired 8 Oct 2026 and no longer read or written: students never see
  /// fees. Kept so existing rows and migrations stay intact.
  showFeesToStudents         Boolean @default(false)
  /// A subject "needs attention" below this percentage (see server/exams/attention.ts).
  needsAttentionPercent      Int     @default(40)
  /// …or when this many of the last three tests are below it.
  needsAttentionRepeat       Int     @default(2)
  /// A student's attendance needs attention below this percentage…
  attendanceAttentionPercent Int     @default(75)
  /// …over this many most recent days (registers marked in that window).
  attendanceAttentionDays    Int     @default(30)
  /// Lets the fee desk take one payment for several siblings, split per child.
  familyPaymentEnabled       Boolean @default(false)
  /// The school's grading scale: [{"min": 91, "grade": "A1"}, …] from highest
  /// to lowest, the last band starting at 0. Null: the CBSE nine-point scale.
  gradeBands                 Json?
  /// A paper without its own pass mark passes at this percentage.
  passPercent                Int     @default(33)
  /// Late fee added once to each instalment still unpaid this many days after
  /// its due date (paise). Zero: no late fees.
  lateFeeMinor               Int     @default(0)
  lateFeeGraceDays           Int     @default(0)

  /// When the daily register is taken, and whether it submits itself.
  attendanceTiming     RegisterTiming     @default(FIRST_PERIOD)
  /// Kept for history only: since 6 Oct 2026 attendance is always submitted by the teacher (MANUAL).
  attendanceSubmission RegisterSubmission @default(MANUAL)
  /// Whether teachers may mark a student Half Day. The School Admin turns it off under Settings → Attendance.
  attendanceHalfDay    Boolean            @default(true)

  /// Optional setup steps the School Admin chose to skip for now
  /// ("profile", "classTeachers", "subjectTeachers", "timetable", "fees").
  /// Skipping hides the nudge; it never disables anything.
  setupSkipped      String[] @default([])
  /// The last concern number issued (CON-1, CON-2, …). Incremented in the
  /// concern's own transaction, so two concerns never share a number.
  lastConcernNumber Int      @default(0)

  /// Set when the contact proves they own the registration address. A school
  /// cannot be approved before this: otherwise anyone could register a school
  /// in someone else's name.
  contactEmailVerifiedAt DateTime?

  // --- review trail ---
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?     @relation("SchoolReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  rejectionReason String?
  suspendedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  resultSchemes         ResultScheme[]
  planRequests          PlanChangeRequest[]
  campusRequestCreated  CampusRequest[]            @relation("CampusRequestCreatedSchool")
  campusRequestsFrom    CampusRequest[]            @relation("CampusRequestFromSchool")
  featureRequests       FeatureRequest[]
  apiTokens             ApiToken[]
  emailVerifications    EmailVerification[]
  academicSessions      AcademicSession[]
  classes               Class[]
  streams               Stream[]
  sections              Section[]
  subjects              Subject[]
  teachers              Teacher[]
  teacherAssignments    TeacherSubjectAssignment[]
  students              Student[]
  enrollments           StudentEnrollment[]
  parents               Parent[]
  parentStudents        ParentStudent[]
  timetableSlots        TimetableSlot[]
  noticeReads           NoticeRead[]
  rooms                 Room[]
  classSessions         ClassSession[]
  studentAttendance     StudentAttendance[]
  teacherAttendance     TeacherAttendance[]
  homework              Homework[]
  studentRemarks        StudentRemark[]
  admissionDrives       AdmissionDrive[]
  admissionAssignments  AdmissionAssignment[]
  admissionDocuments    AdmissionDocument[]
  admissionApplications AdmissionApplication[]
  notices               Notice[]
  events                Event[]
  pages                 SchoolPage[]
  media                 SchoolMedia[]
  subscriptions         Subscription[]
  auditLogs             AuditLog[]
  assessments           Assessment[]
  assessmentResults     AssessmentResult[]
  lessonMaterials       LessonMaterial[]
  teacherSalaries       TeacherSalary[]
  classTeacherHistory   ClassTeacherAssignment[]
  feeHeads              FeeHead[]
  feeCharges            FeeCharge[]
  feePayments           FeePayment[]
  expenses              Expense[]
  salaryPayments        SalaryPayment[]
  holidays              Holiday[]
  exams                 Exam[]
  leaveRequests         LeaveRequest[]
  noticeRecipients      NoticeRecipient[]
  meetings              Meeting[]
  meetingSections       MeetingSection[]
  meetingRecipients     MeetingRecipient[]
  meetingStudents       MeetingStudent[]
  ptmFamilies           PtmFamily[]
  statusChanges         StatusChange[]
  studentSupports       StudentSupport[]
  supportNotes          SupportNote[]
  supportConcerns       SupportConcern[]
  concernMessages       ConcernMessage[]
  sectionStreams        SectionStream[]
  complaints            Complaint[]
  staffMembers          StaffMember[]
  staffRoleProfiles     StaffRoleProfile[]
  staffSubstitutions    StaffSubstitution[]
  transportTripLogs     TransportTripLog[]
  transportIssues       TransportIssue[]
  vehicles              Vehicle[]
  transportRoutes       TransportRoute[]
  routeStops            RouteStop[]
  studentTransport      StudentTransport[]
  books                 Book[]
  bookIssues            BookIssue[]
  bookCopies            BookCopy[]
  studentLeaves         StudentLeave[]
  assets                Asset[]
  assetEvents           AssetEvent[]

  attendanceRegisters AttendanceRegister[]
  registerCovers      RegisterCover[]
  workCovers          WorkCover[]

  staffAttendance StaffAttendance[]

  admissionCounters AdmissionCounter[]
  profilePhotos     ProfilePhoto[]

  admissionFollowUps AdmissionFollowUp[]
  feeConcessions     FeeConcession[]
  familyPayments     FamilyPayment[]
  feeCarryForwards   FeeCarryForward[]

  enquiries           Enquiry[]
  enquiryChildren     EnquiryChild[]
  enquiryFollowUps    EnquiryFollowUp[]
  enquiryFeeRevisions EnquiryFeeRevision[]
  admissionPortal     AdmissionPortal?
  visitors            Visitor[]
  responsibilities    Responsibility[]
  staffDocuments      StaffDocument[]

  @@index([status])
  @@index([createdAt])
  @@index([organizationId])
  @@index([isDemo, demoExpiresAt])
}

/// A term exam for one section — "Half-Yearly 2026" for 10-A. Its papers are
/// ordinary `Assessment` rows (one per subject) and its marks are
/// `AssessmentResult` rows, so class tests and exams share one marks table.
/// Creating the same exam for several sections writes one `Exam` each.
model Exam {
  id                String     @id @default(cuid())
  schoolId          String
  academicSessionId String
  sectionId         String
  name              String
  startDate         DateTime   @db.Date
  endDate           DateTime   @db.Date
  status            ExamStatus @default(DRAFT)
  publishedAt       DateTime?
  /// Who published it (null for exams published before this was recorded).
  publishedById     String?
  /// Reviewed and verified: every paper submitted and complete, checked by a
  /// School Admin or Principal. Required before publishing; cleared when marks
  /// reopen or the exam is unpublished.
  verifiedAt        DateTime?
  verifiedById      String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  school          School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSession AcademicSession @relation(fields: [schoolId, academicSessionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  section         Section         @relation(fields: [schoolId, sectionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)

  papers Assessment[]

  @@unique([schoolId, id])
  /// The same exam cannot be set twice for one section in a session.
  @@unique([schoolId, academicSessionId, sectionId, name])
  @@index([schoolId, academicSessionId, status])
}

/// A teacher's request for leave, both ends inclusive.
///
/// Approval writes ON_LEAVE into the staff register for the days already
/// reached, and pre-fills it for the days still ahead, so the register and the
/// leave never disagree about whether someone was absent.
/// Leave asked for by a teacher or by a non-teaching staff member — exactly
/// one of `teacherId` / `staffMemberId` is set (checked in the database).
model LeaveRequest {
  id            String      @id @default(cuid())
  schoolId      String
  teacherId     String?
  staffMemberId String?
  type          LeaveType
  startDate     DateTime    @db.Date
  endDate       DateTime    @db.Date
  reason        String
  status        LeaveStatus @default(PENDING)
  /// The School Admin who decided, and what they said.
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher     Teacher?     @relation(fields: [schoolId, teacherId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  staffMember StaffMember? @relation(fields: [schoolId, staffMemberId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  reviewedBy  User?        @relation("LeaveReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([schoolId, id])
  @@index([schoolId, status, startDate])
  @@index([schoolId, teacherId, startDate])
  @@index([schoolId, staffMemberId, startDate])
}

/// A meeting the school office calls: a parent-teacher meeting, a staff
/// meeting, an assembly for one class. Nobody books anything — the office
/// sets the time and chooses who is invited, and each invitee sees it in
/// their portal.
///
/// Who is invited is `audiences` within `scope`:
///   * SCHOOL   — everyone in those audiences.
///   * SECTIONS — the students, parents and teachers of the `sections` listed
///                (a non-teaching staff audience has no sections and is refused).
///   * PEOPLE   — hand-picked people: teachers and staff in `recipients`, and
///                the students in `students` — who see it with the STUDENTS
///                audience — and their guardians, with PARENTS.
///
/// Times are minutes from midnight in the school's zone, like the timetable.
/// Without `endMinute` the meeting runs to the end of its day.
model Meeting {
  id                String            @id @default(cuid())
  schoolId          String
  /// The session it was scheduled in; null when the school had none yet.
  academicSessionId String?
  type              MeetingType       @default(GENERAL)
  title             String
  description       String?
  date              DateTime          @db.Date
  startMinute       Int
  endMinute         Int?
  location          String?
  meetingLink       String?
  audiences         MeetingAudience[]
  scope             MeetingScope      @default(SCHOOL)
  status            MeetingStatus     @default(SCHEDULED)
  cancelledAt       DateTime?
  cancelReason      String?
  createdById       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSession AcademicSession? @relation(fields: [schoolId, academicSessionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  createdBy       User?            @relation("MeetingCreator", fields: [createdById], references: [id], onDelete: SetNull)

  sections    MeetingSection[]
  recipients  MeetingRecipient[]
  students    MeetingStudent[]
  supports    StudentSupport[]
  ptmFamilies PtmFamily[]

  @@unique([schoolId, id])
  @@index([schoolId, date])
  @@index([schoolId, status, date])
}

/// A section whose students, parents and teachers a SECTIONS meeting reaches.
model MeetingSection {
  id        String @id @default(cuid())
  schoolId  String
  meetingId String
  sectionId String

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  meeting Meeting @relation(fields: [schoolId, meetingId], references: [schoolId, id], onDelete: Cascade, onUpdate: NoAction)
  section Section @relation(fields: [schoolId, sectionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([schoolId, id])
  @@unique([schoolId, meetingId, sectionId])
  @@index([schoolId, sectionId])
}

/// A student a PEOPLE meeting concerns. Resolved on every read, like
/// `NoticeRecipient`, so a guardian linked later still sees it.
model MeetingStudent {
  id        String @id @default(cuid())
  schoolId  String
  meetingId String
  studentId String

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  meeting Meeting @relation(fields: [schoolId, meetingId], references: [schoolId, id], onDelete: Cascade, onUpdate: NoAction)
  student Student @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([schoolId, id])
  @@unique([schoolId, meetingId, studentId])
  @@index([schoolId, studentId])
}

/// One child's family at one PTM: the parent's optional response, and what a
/// teacher recorded afterwards. One row per PTM and child (never duplicated).
/// `remarks` and `followUp` are staff-only notes, never shown to the family.
model PtmFamily {
  id            String         @id @default(cuid())
  schoolId      String
  meetingId     String
  studentId     String
  response      PtmResponse?
  respondedById String?
  respondedAt   DateTime?
  attendance    PtmAttendance?
  remarks       String?
  followUp      String?
  recordedById  String?
  recordedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  meeting Meeting @relation(fields: [schoolId, meetingId], references: [schoolId, id], onDelete: Cascade, onUpdate: NoAction)
  student Student @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([schoolId, id])
  @@unique([schoolId, meetingId, studentId])
  @@index([schoolId, studentId])
}

/// A teacher or staff member a PEOPLE meeting is addressed to, by login.
model MeetingRecipient {
  id        String @id @default(cuid())
  schoolId  String
  meetingId String
  userId    String

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  meeting Meeting @relation(fields: [schoolId, meetingId], references: [schoolId, id], onDelete: Cascade, onUpdate: NoAction)
  user    User    @relation(fields: [schoolId, userId], references: [schoolId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([schoolId, id])
  @@unique([schoolId, meetingId, userId])
  @@index([schoolId, userId])
}

/// One change to a person's status or login, with when it took effect and
/// why — the history behind "Transferred, left 28 Sep 2026". Rows are only
/// ever added. Exactly one of the person ids is set, matching `person`.
model StatusChange {
  id            String           @id @default(cuid())
  schoolId      String
  person        PersonKind
  kind          StatusChangeKind
  studentId     String?
  parentId      String?
  teacherId     String?
  staffMemberId String?
  fromValue     String
  toValue       String
  effectiveDate DateTime         @db.Date
  reason        String?
  remarks       String?
  changedById   String?
  createdAt     DateTime         @default(now())

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student     Student?     @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Cascade, onUpdate: NoAction)
  parent      Parent?      @relation(fields: [schoolId, parentId], references: [schoolId, id], onDelete: Cascade, onUpdate: NoAction)
  teacher     Teacher?     @relation(fields: [schoolId, teacherId], references: [schoolId, id], onDelete: Cascade, onUpdate: NoAction)
  staffMember StaffMember? @relation(fields: [schoolId, staffMemberId], references: [schoolId, id], onDelete: Cascade, onUpdate: NoAction)
  changedBy   User?        @relation("StatusChanger", fields: [changedById], references: [id], onDelete: SetNull)

  @@unique([schoolId, id])
  @@index([schoolId, studentId, createdAt])
  @@index([schoolId, teacherId, createdAt])
  @@index([schoolId, staffMemberId, createdAt])
  @@index([schoolId, parentId, createdAt])
}

/// Extra academic support for one student: why, in which subject, what is
/// being done, and how it is going. The teacher owns it; the office monitors
/// and coordinates; the family sees a supportive summary.
model StudentSupport {
  id                  String          @id @default(cuid())
  schoolId            String
  academicSessionId   String
  studentId           String
  classId             String
  sectionId           String
  /// Null for support that is not about one subject (e.g. attendance).
  subjectId           String?
  /// The teacher responsible for the support.
  teacherId           String?
  source              SupportSource
  reason              SupportReason
  reasonNote          String?
  /// What the student is working on, e.g. "Fractions".
  topic               String?
  priority            SupportPriority @default(MEDIUM)
  action              SupportAction
  actionNote          String?
  status              SupportStatus   @default(NEW)
  /// The parent concern this support answers, if any.
  concernId           String?
  /// The extra class arranged for it, as a meeting.
  extraClassMeetingId String?
  createdById         String?
  resolvedAt          DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  school          School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSession AcademicSession @relation(fields: [schoolId, academicSessionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  student         Student         @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Cascade, onUpdate: NoAction)
  class           Class           @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  section         Section         @relation(fields: [schoolId, sectionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  subject         Subject?        @relation(fields: [schoolId, subjectId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  teacher         Teacher?        @relation(fields: [schoolId, teacherId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  concern         SupportConcern? @relation(fields: [schoolId, concernId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  extraClass      Meeting?        @relation(fields: [schoolId, extraClassMeetingId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  createdBy       User?           @relation("SupportCreator", fields: [createdById], references: [id], onDelete: SetNull)
  notes           SupportNote[]

  /// A remark the teacher chooses to share with the family; notes stay staff-only.
  parentRemark String?

  @@unique([schoolId, id])
  @@index([schoolId, status, createdAt])
  @@index([schoolId, studentId])
  @@index([schoolId, teacherId, status])
  @@index([schoolId, sectionId])
}

/// A follow-up on a support record: what was done or seen, and any change of
/// status that came with it. Staff-facing; families see only the status.
model SupportNote {
  id         String         @id @default(cuid())
  schoolId   String
  supportId  String
  authorId   String?
  note       String
  fromStatus SupportStatus?
  toStatus   SupportStatus?
  createdAt  DateTime       @default(now())

  school  School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  support StudentSupport @relation(fields: [schoolId, supportId], references: [schoolId, id], onDelete: Cascade, onUpdate: NoAction)
  author  User?          @relation("SupportNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([schoolId, id])
  @@index([schoolId, supportId, createdAt])
}

/// A subject-wise concern between a child's family and the teacher who
/// teaches them that subject: raised by a parent (routed to the subject
/// teacher of the child's class, section and stream, else to the School
/// Admin) or by that teacher (for the child's parents). The placement and the
/// teacher are copied at creation and never rewritten, so a later change of
/// teacher or section leaves the history as it was. The conversation is in
/// `ConcernMessage`.
model SupportConcern {
  id                String          @id @default(cuid())
  schoolId          String
  /// Per school: CON-1, CON-2, …
  number            Int
  studentId         String
  /// The parent who raised it; null when a teacher or the office raised it
  /// (then it is addressed to all of the child's parents).
  parentId          String?
  subjectId         String?
  /// The subject teacher it was routed to. Null: waiting with the School Admin.
  teacherId         String?
  raisedBy          SupportSource
  type              ConcernType
  priority          SupportPriority @default(MEDIUM)
  status            ConcernStatus   @default(OPEN)
  /// Placement when the concern was raised.
  academicSessionId String?
  classId           String?
  sectionId         String?
  streamId          String?
  createdById       String?
  /// The School Admin asked the teacher for an update; cleared by their reply.
  updateRequestedAt DateTime?
  lastMessageAt     DateTime        @default(now())
  reviewedAt        DateTime?
  resolvedAt        DateTime?
  closedAt          DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student         Student          @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Cascade, onUpdate: NoAction)
  academicSession AcademicSession? @relation(fields: [schoolId, academicSessionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  class           Class?           @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  parent          Parent?          @relation(fields: [schoolId, parentId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  subject         Subject?         @relation(fields: [schoolId, subjectId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  teacher         Teacher?         @relation(fields: [schoolId, teacherId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  section         Section?         @relation(fields: [schoolId, sectionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  stream          Stream?          @relation(fields: [schoolId, streamId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  createdBy       User?            @relation("ConcernCreator", fields: [createdById], references: [id], onDelete: SetNull)
  supports        StudentSupport[]
  messages        ConcernMessage[]

  @@unique([schoolId, id])
  @@unique([schoolId, number])
  @@index([schoolId, status, createdAt])
  @@index([schoolId, teacherId, status])
  @@index([schoolId, studentId])
}

/// One message in a concern's conversation. `internal` messages (the School
/// Admin asking for an update) are for staff only; families never see them.
model ConcernMessage {
  id         String         @id @default(cuid())
  schoolId   String
  concernId  String
  authorId   String?
  authorRole SupportSource
  body       String
  internal   Boolean        @default(false)
  fromStatus ConcernStatus?
  toStatus   ConcernStatus?
  createdAt  DateTime       @default(now())

  school  School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  concern SupportConcern @relation(fields: [schoolId, concernId], references: [schoolId, id], onDelete: Cascade, onUpdate: NoAction)
  author  User?          @relation("ConcernMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([schoolId, id])
  @@index([schoolId, concernId, createdAt])
}

/// A complaint or request from a parent or student to the school office.
/// Visible to the School Admin, to the staff member it is assigned to, and to
/// whoever raised it — never to anyone else.
model Complaint {
  id           String            @id @default(cuid())
  schoolId     String
  /// The parent or student who raised it.
  raisedById   String?
  /// The child it concerns (for a parent, one of their own).
  studentId    String?
  category     ComplaintCategory
  priority     ComplaintPriority @default(MEDIUM)
  subject      String
  description  String
  status       ComplaintStatus   @default(OPEN)
  /// The staff member handling it: the School Admin or a teacher.
  assignedToId String?
  response     String?
  respondedAt  DateTime?
  resolvedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  raisedBy   User?    @relation("ComplaintRaiser", fields: [raisedById], references: [id], onDelete: SetNull)
  assignedTo User?    @relation("ComplaintAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  student    Student? @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([schoolId, id])
  @@index([schoolId, status, createdAt])
  @@index([schoolId, raisedById])
  @@index([schoolId, assignedToId])
}

/// A member of non-teaching staff: accountant, driver, librarian, peon.
/// Basic employment details only — no documents.
///
/// A staff member may be given a login (`userId`, role NON_TEACHING_STAFF).
/// `role` is their designation and grants nothing by itself; what they can
/// open beyond their own record, notices and meetings is `permissions`.
model StaffMember {
  id                    String            @id @default(cuid())
  schoolId              String
  employeeId            String
  firstName             String
  lastName              String
  role                  StaffRole
  designation           String?
  department            String?
  phone                 String?
  email                 String?
  joiningDate           DateTime?         @db.Date
  dateOfBirth           DateTime?         @db.Date
  gender                Gender?
  addressLine           String?
  city                  String?
  state                 String?
  postalCode            String?
  /// Years of work before joining, as told at hiring.
  experienceYears       Int?
  employmentType        EmploymentType?
  emergencyContactName  String?
  emergencyContactPhone String?
  status                TeacherStatus     @default(ACTIVE)
  notes                 String?
  /// Superseded by `grants` (4 Oct 2026); kept, unread, so nothing is lost.
  permissions           StaffPermission[] @default([])
  /// What this person may do: module × action keys from `@/lib/staff-access`.
  grants                String[]          @default([])
  /// True once the School Admin set this person's permissions by hand. Only
  /// staff never customised follow their role's updated defaults automatically.
  grantsCustomized      Boolean           @default(false)
  /// Their role profile (built-in or custom); null = the built-in one for `role`.
  roleProfileId         String?
  userId                String?           @unique
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  statusChanges   StatusChange[]
  drivingRoutes   TransportRoute[] @relation("RouteDriver")
  attendingRoutes TransportRoute[] @relation("RouteAttendant")
  bookIssues      BookIssue[]
  leaveRequests   LeaveRequest[]

  workCoversAbsent WorkCover[] @relation("WorkCoverAbsent")
  workCoversCover  WorkCover[] @relation("WorkCoverCover")

  attendance StaffAttendance[]

  roleProfile     StaffRoleProfile?   @relation(fields: [schoolId, roleProfileId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  substitutedBy   StaffSubstitution[] @relation("SubstitutionOriginal")
  substitutingFor StaffSubstitution[] @relation("SubstitutionSubstitute")

  documents      StaffDocument[]
  salaries       TeacherSalary[]
  salaryPayments SalaryPayment[]

  @@unique([schoolId, id])
  @@unique([schoolId, employeeId])
  @@index([schoolId, role, status])
}

/// A non-teaching role at one school: the built-in designations (one per
/// `StaffRole`, created when first needed) and any the school adds. Holds
/// the grants a new staff member in the role starts with.
model StaffRoleProfile {
  id            String    @id @default(cuid())
  schoolId      String
  name          String
  /// The designation underneath: decides what the role can never hold.
  baseRole      StaffRole
  isCustom      Boolean   @default(false)
  description   String?
  defaultGrants String[]  @default([])
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  school School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff  StaffMember[]

  @@unique([schoolId, id])
  @@unique([schoolId, name])
}

/// One staff member covering another's work for a span of days, with the
/// access that needs. Status is worked out from the dates (scheduled, active,
/// expired) or `endedAt` (ended early) — nothing has to be switched off by hand,
/// and nothing is deleted. The original's own assignments are never changed.
model StaffSubstitution {
  id                String    @id @default(cuid())
  schoolId          String
  originalStaffId   String
  substituteStaffId String
  startDate         DateTime  @db.Date
  endDate           DateTime  @db.Date
  reason            String
  notes             String?
  /// What the substitute may do meanwhile, on top of their own grants.
  grants            String[]  @default([])
  /// Also cover the original's routes (as driver or attendant).
  coverRoutes       Boolean   @default(true)
  endedAt           DateTime?
  endedById         String?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  original   StaffMember @relation("SubstitutionOriginal", fields: [schoolId, originalStaffId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  substitute StaffMember @relation("SubstitutionSubstitute", fields: [schoolId, substituteStaffId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  createdBy  User?       @relation("SubstitutionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  endedBy    User?       @relation("SubstitutionEnder", fields: [endedById], references: [id], onDelete: SetNull)

  @@unique([schoolId, id])
  @@index([schoolId, substituteStaffId, startDate])
  @@index([schoolId, originalStaffId, startDate])
}

enum TransportTrip {
  PICKUP
  DROP
}

enum TransportTripStatus {
  PICKED_UP
  NOT_PRESENT
  DROPPED
  ISSUE
}

/// A student's pickup or drop on one day, as the driver or attendant marked it.
model TransportTripLog {
  id         String              @id @default(cuid())
  schoolId   String
  date       DateTime            @db.Date
  routeId    String
  studentId  String
  stopId     String?
  trip       TransportTrip
  status     TransportTripStatus
  note       String?
  markedById String?
  markedAt   DateTime            @default(now())

  school   School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  route    TransportRoute @relation(fields: [schoolId, routeId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  student  Student        @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  markedBy User?          @relation("TripMarker", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([schoolId, id])
  @@unique([schoolId, date, studentId, trip])
  @@index([schoolId, routeId, date])
}

/// Something wrong on a route that day — a breakdown, a road closed — reported by its crew.
model TransportIssue {
  id           String   @id @default(cuid())
  schoolId     String
  routeId      String
  date         DateTime @db.Date
  note         String
  reportedById String?
  createdAt    DateTime @default(now())

  school     School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  route      TransportRoute @relation(fields: [schoolId, routeId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  reportedBy User?          @relation("TransportIssueReporter", fields: [reportedById], references: [id], onDelete: SetNull)

  @@unique([schoolId, id])
  @@index([schoolId, routeId, date])
}

model Vehicle {
  id             String        @id @default(cuid())
  schoolId       String
  registrationNo String
  type           VehicleType
  capacity       Int
  status         VehicleStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  school School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  routes TransportRoute[]

  @@unique([schoolId, id])
  @@unique([schoolId, registrationNo])
}

/// A bus route: its vehicle, driver and attendant, and its stops in order.
model TransportRoute {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  /// Route number as painted on the bus ("R-3"), optional.
  code        String?
  /// Where the route starts and ends, e.g. "Vijay Nagar depot" → "School gate".
  startPoint  String?
  endPoint    String?
  vehicleId   String?
  driverId    String?
  attendantId String?
  isActive    Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school    School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  vehicle   Vehicle?     @relation(fields: [schoolId, vehicleId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  driver    StaffMember? @relation("RouteDriver", fields: [schoolId, driverId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  attendant StaffMember? @relation("RouteAttendant", fields: [schoolId, attendantId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)

  stops    RouteStop[]
  students StudentTransport[]
  tripLogs TransportTripLog[]
  issues   TransportIssue[]

  @@unique([schoolId, id])
  @@unique([schoolId, name])
}

/// A stop on a route. Pickup and drop are minutes from midnight.
model RouteStop {
  id           String   @id @default(cuid())
  schoolId     String
  routeId      String
  name         String
  /// Landmark or address, so a new driver can find it.
  location     String?
  sequence     Int
  pickupMinute Int?
  dropMinute   Int?
  createdAt    DateTime @default(now())

  school   School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  route    TransportRoute     @relation(fields: [schoolId, routeId], references: [schoolId, id], onDelete: Cascade, onUpdate: NoAction)
  students StudentTransport[]

  @@unique([schoolId, id])
  @@unique([schoolId, routeId, sequence])
}

/// A student's place on a route. One per student: moving routes edits it.
model StudentTransport {
  id        String          @id @default(cuid())
  schoolId  String
  studentId String
  routeId   String
  stopId    String?
  status    TransportStatus @default(ACTIVE)
  startDate DateTime        @db.Date
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  school  School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student        @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Cascade, onUpdate: NoAction)
  route   TransportRoute @relation(fields: [schoolId, routeId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  stop    RouteStop?     @relation(fields: [schoolId, stopId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([schoolId, id])
  @@unique([schoolId, studentId])
  @@index([schoolId, routeId])
}

/// A title in the library. Copies on loan are counted from open issues, so
/// "available" can never drift from the loans themselves.
model Book {
  id        String   @id @default(cuid())
  schoolId  String
  title     String
  author    String?
  isbn      String?
  category  String?
  publisher String?
  shelf     String?
  quantity  Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  issues BookIssue[]
  copies BookCopy[]

  @@unique([schoolId, id])
  @@unique([schoolId, isbn])
  @@index([schoolId, title])
}

/// One copy lent to one borrower: a student, a teacher or a staff member.
model BookIssue {
  id            String    @id @default(cuid())
  schoolId      String
  bookId        String
  /// The physical copy lent. Null only for loans made before copies existed.
  copyId        String?
  studentId     String?
  teacherId     String?
  staffMemberId String?
  issuedOn      DateTime  @db.Date
  dueOn         DateTime  @db.Date
  returnedOn    DateTime? @db.Date
  fineMinor     Int       @default(0)
  finePaid      Boolean   @default(false)
  notes         String?
  issuedById    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  book        Book         @relation(fields: [schoolId, bookId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  copy        BookCopy?    @relation(fields: [schoolId, copyId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  student     Student?     @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  teacher     Teacher?     @relation(fields: [schoolId, teacherId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  staffMember StaffMember? @relation(fields: [schoolId, staffMemberId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  issuedBy    User?        @relation("BookIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  /// The loan ended because the copy was lost while out (no return date is invented).
  lostOn    DateTime? @db.Date
  /// The copy came back damaged: the loan closed that day and the copy left stock.
  damagedOn DateTime? @db.Date

  /// The borrower's class, section and stream on the day of issue, kept as
  /// text so the history still reads right after promotion. Null for staff
  /// borrowers and for loans made before it was recorded.
  borrowerGroup String?
  /// When the return (or loss/damage) was processed, and by whom. `returnedOn`
  /// stays the date the book is counted back on, which may be back-dated.
  returnedAt    DateTime?
  returnedById  String?
  returnedBy    User?     @relation("BookReturner", fields: [returnedById], references: [id], onDelete: SetNull)

  @@unique([schoolId, id])
  @@index([schoolId, bookId, returnedOn])
  @@index([schoolId, dueOn, returnedOn])
  @@index([schoolId, studentId])
  @@index([schoolId, copyId])
}

enum BookCopyStatus {
  AVAILABLE
  ISSUED
  WITHDRAWN
  /// Reported lost — out of stock for good; its loan history stays.
  LOST
  /// Too damaged to lend — out of stock; its loan history stays.
  DAMAGED
}

/// A test's marks: being entered (DRAFT) or handed in by the teacher (SUBMITTED).
/// A submitted class test's results are visible to families; an exam paper's
/// wait for the exam to be published.
enum AssessmentMarksStatus {
  DRAFT
  SUBMITTED
}

/// Where an admission enquiry came from.
enum AdmissionSource {
  WEBSITE
  WALK_IN
  PHONE
  ADMIN
  /// Entered by a teacher assigned to a class in an admission drive.
  DRIVE
}

/// The admin's switch for a drive. SCHEDULED and ACTIVE both run on the
/// drive's dates; PAUSED, CLOSED and CANCELLED stop all teacher work.
enum AdmissionDriveStatus {
  SCHEDULED
  ACTIVE
  PAUSED
  CLOSED
  CANCELLED
}

/// How a student joined: a fresh admission, a transfer from another school, or a return.
enum AdmissionType {
  NEW
  TRANSFER
  READMISSION
}

/// A concession is a fixed amount off a charge, or a percentage of it.
enum ConcessionKind {
  FIXED
  PERCENT
}

/// One physical copy of a book, with its own accession code (BK-0001). A copy
/// is ISSUED while exactly one open loan holds it; issuing flips it from
/// AVAILABLE in the loan's own transaction, so two desks cannot lend it twice.
model BookCopy {
  id        String         @id @default(cuid())
  schoolId  String
  bookId    String
  code      String
  status    BookCopyStatus @default(AVAILABLE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  school School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  book   Book        @relation(fields: [schoolId, bookId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  issues BookIssue[]

  /// Why a copy was reported lost or damaged, and when.
  conditionNote   String?
  statusChangedAt DateTime?

  @@unique([schoolId, id])
  @@unique([schoolId, code])
  @@index([schoolId, bookId, status])
}

enum StudentLeaveReason {
  SICK
  FAMILY_FUNCTION
  MEDICAL_APPOINTMENT
  PERSONAL
  TRAVEL
  OTHER
}

/// PENDING → (class teacher approves) TEACHER_APPROVED → (School Admin
/// approves) APPROVED. Only APPROVED is final leave. A rejection by either is
/// final (REJECTED). The School Admin may decide at any step, or overturn.
enum StudentLeaveStatus {
  PENDING
  TEACHER_APPROVED
  APPROVED
  REJECTED
  CANCELLED
}

/// A leave request for a student, normally from a parent (or the student,
/// where they have a login). The class teacher of the student's section
/// reviews it first; the School Admin gives the final approval. Approval never writes attendance: the
/// register shows the leave and the teacher records the day.
model StudentLeave {
  id                  String             @id @default(cuid())
  schoolId            String
  studentId           String
  /// The section the student was in when it was asked for.
  sectionId           String?
  fromDate            DateTime           @db.Date
  toDate              DateTime           @db.Date
  reason              StudentLeaveReason
  reasonText          String?
  note                String?
  status              StudentLeaveStatus @default(PENDING)
  requestedById       String?
  requestedByRole     UserRole
  decidedById         String?
  decidedAt           DateTime?
  decisionComment     String?
  /// The class teacher's review, kept after the School Admin's final decision.
  teacherReviewedById String?
  teacherReviewedAt   DateTime?
  /// What the class teacher decided (true = approved and sent on).
  teacherApproved     Boolean?
  teacherComment      String?
  cancelledAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  school            School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherReviewedBy User?    @relation("StudentLeaveTeacherReviewer", fields: [teacherReviewedById], references: [id], onDelete: SetNull)
  student           Student  @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Cascade, onUpdate: NoAction)
  section           Section? @relation(fields: [schoolId, sectionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  requestedBy       User?    @relation("StudentLeaveRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedBy         User?    @relation("StudentLeaveDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([schoolId, id])
  @@index([schoolId, status, fromDate])
  @@index([schoolId, studentId, fromDate])
  @@index([schoolId, sectionId, status])
}

/// A school asset or a batch of identical ones (quantity).
model Asset {
  id                String         @id @default(cuid())
  schoolId          String
  code              String
  name              String
  category          AssetCategory
  purchaseDate      DateTime?      @db.Date
  purchaseCostMinor Int?
  quantity          Int            @default(1)
  location          String?
  /// The person or department it is with — free text, not a login.
  assignedTo        String?
  condition         AssetCondition @default(GOOD)
  status            AssetStatus    @default(ACTIVE)
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  school School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  events AssetEvent[]

  @@unique([schoolId, id])
  @@unique([schoolId, code])
  @@index([schoolId, category, status])
}

/// The history of an asset: every status change, reassignment and repair note.
model AssetEvent {
  id         String       @id @default(cuid())
  schoolId   String
  assetId    String
  summary    String
  fromStatus AssetStatus?
  toStatus   AssetStatus?
  actorId    String?
  createdAt  DateTime     @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  asset  Asset  @relation(fields: [schoolId, assetId], references: [schoolId, id], onDelete: Cascade, onUpdate: NoAction)
  actor  User?  @relation("AssetEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([schoolId, id])
  @@index([schoolId, assetId, createdAt])
}

/// Subscription plan offered by the platform. Priced in paise/cents to keep
/// money in integers and out of floating point.
model Plan {
  id              String    @id @default(cuid())
  /// The three original plans keep their tier; plans made in the Plan Builder have none.
  tier            PlanTier? @unique
  /// Stable key for links and registration (`/register?plan=growth`). Never a display name.
  slug            String    @unique
  /// The template this plan started from ("starter", "growth", "pro"), so the
  /// Plan Builder can say "Customized" and restore its defaults. Null: none.
  templateKey     String?
  name            String
  description     String?
  priceMinor      Int
  currency        String    @default("INR")
  /// Null means unlimited.
  maxStudents     Int?
  maxTeachers     Int?
  maxAdmins       Int?
  storageMb       Int?
  /// Optional modules this plan includes (keys of OPTIONAL_MODULES in
  /// lib/school-modules.ts). Core modules are always on and are not listed.
  optionalModules String[]  @default([])
  /// How many campuses (schools) one Owner/Organization may run on this plan.
  /// 1 = single school only: multi-campus is off.
  campusLimit     Int       @default(1)
  /// Optional roles the plan includes (lib/school-roles.ts). Core roles are always on.
  availableRoles  String[]  @default(["PRINCIPAL", "ACCOUNTANT", "RECEPTIONIST", "LIBRARIAN", "DRIVER", "TRANSPORT_ATTENDANT", "PEON", "OFFICE_STAFF", "COORDINATOR", "SECURITY", "LAB_ASSISTANT", "OTHER"])
  /// Per-role/user limits (key → maximum); a missing key is unlimited.
  roleLimits      Json      @default("{}")
  /// Open for new registrations and plan requests (activate / deactivate).
  isActive        Boolean   @default(true)

  /// DRAFT: never published, hidden. PUBLISHED: the live configuration.
  /// ARCHIVED: hidden from everyone new; existing subscriptions carry on.
  status                PlanStatus    @default(PUBLISHED)
  displayOrder          Int           @default(0)
  /// Short selling points for the public plan card.
  highlights            String[]      @default([])
  billingPeriod         BillingPeriod @default(YEARLY)
  /// Prices not decided: show "Price on request", never a number.
  priceOnRequest        Boolean       @default(false)
  /// Organization-level features (lib/plan-features.ts), e.g. the organization dashboard.
  features              String[]      @default([])
  /// `campusLimit` is the number of campuses included in the plan fee. Past
  /// it, more campuses are possible only when allowed, at the price below.
  extraCampusAllowed    Boolean       @default(false)
  extraCampusPriceMinor Int?
  extraCampusPeriod     BillingPeriod @default(YEARLY)
  /// Hard cap on campuses including extras; null = no cap.
  maxCampuses           Int?
  /// Unpublished edits from the Plan Builder. Nothing reads them except the
  /// builder and its preview; publishing copies them onto the columns above.
  draft                 Json?
  draftUpdatedAt        DateTime?
  draftById             String?
  publishedAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  subscriptions Subscription[]
  requestedBy   PlanChangeRequest[] @relation("PlanRequested")
  requestedFrom PlanChangeRequest[] @relation("PlanCurrent")
}

/// A school's subscription. Payment integration is deliberately out of V1;
/// this records what a school is entitled to so limits can be enforced later.
model Subscription {
  id        String             @id @default(cuid())
  schoolId  String
  school    School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  planId    String
  plan      Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  status    SubscriptionStatus @default(TRIALING)
  startsAt  DateTime
  endsAt    DateTime?
  notes     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([schoolId, id])
  @@index([schoolId, status])
  @@index([endsAt])
}

/// Promotional offer on the SaaS marketing homepage, managed by the Super
/// Admin. Display is bounded by startsAt/endsAt so expired offers stop showing
/// without anyone having to unpublish them.
model PlatformOffer {
  id          String    @id @default(cuid())
  title       String
  description String?
  priceLabel  String?
  ctaLabel    String?
  ctaHref     String?
  startsAt    DateTime
  endsAt      DateTime?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, startsAt, endsAt])
}

/// Append-only record of consequential actions.
///
/// `schoolId` is null for platform-level events. Never write credentials,
/// password hashes or session tokens into `metadata`.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  schoolId   String?
  school     School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  action     String
  /// The actor's role when it happened ("School Admin", "Accountant"…), kept
  /// so the log still says who did it after their role or status changes.
  actorRole  String?
  /// The area of the school it touched (Fees, Library, Staff…), for filters.
  module     String?
  entityType String
  entityId   String?
  summary    String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([schoolId, module, createdAt])
}

// =============================================================================
// TENANT LEVEL — every model below is owned by exactly one school
// =============================================================================

/// An academic year, e.g. "2026-27". Exactly one session per school should
/// carry `isCurrent`; the application enforces that when switching sessions.
model AcademicSession {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections              Section[]
  enrollments           StudentEnrollment[]
  teacherAssignments    TeacherSubjectAssignment[]
  timetableSlots        TimetableSlot[]
  studentAttendance     StudentAttendance[]
  homework              Homework[]
  studentRemarks        StudentRemark[]
  admissionDrives       AdmissionDrive[]
  admissionApplications AdmissionApplication[]
  assessments           Assessment[]
  exams                 Exam[]
  classTeacherHistory   ClassTeacherAssignment[]
  feeCharges            FeeCharge[]
  feePayments           FeePayment[]
  meetings              Meeting[]

  supports StudentSupport[]
  concerns SupportConcern[]

  attendanceRegisters AttendanceRegister[]

  carriedOut     FeeCarryForward[] @relation("CarryFrom")
  carriedIn      FeeCarryForward[] @relation("CarryTo")
  familyPayments FamilyPayment[]
  enquiries      Enquiry[]
  resultSchemes  ResultScheme[]

  @@unique([schoolId, id])
  @@unique([schoolId, name])
  @@index([schoolId, isCurrent])
}

/// A grade level. Covers Nursery through Class 12 and is school-defined, so a
/// school can offer any subset.
///
/// `level` drives ordering so that sorting never depends on parsing names:
/// Nursery = -3, LKG = -2, UKG = -1, and Class N = N.
model Class {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  level     Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections              Section[]
  notices               Notice[]
  enrollments           StudentEnrollment[]
  admissionAssignments  AdmissionAssignment[]
  admissionApplications AdmissionApplication[]
  enquiryChildren       EnquiryChild[]

  supports StudentSupport[]
  concerns SupportConcern[]

  @@unique([schoolId, id])
  @@unique([schoolId, name])
  @@unique([schoolId, level])
  @@index([schoolId, level])
}

/// An optional specialisation for senior classes. Science/Commerce/Arts are
/// seeded, but a school may define any stream it likes.
model Stream {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections              Section[]
  enrollments           StudentEnrollment[]
  admissionApplications AdmissionApplication[]
  sectionAllocations    SectionStream[]
  teacherAssignments    TeacherSubjectAssignment[]
  concerns              SupportConcern[]
  enquiryChildren       EnquiryChild[]

  assessments Assessment[]

  timetableSlots TimetableSlot[]
  homework       Homework[]
  notices        Notice[]

  @@unique([schoolId, id])
  @@unique([schoolId, name])
}

/// A stream's share of one section's seats: "Class 9 – A: Science 15,
/// Commerce 10". Each section is set up on its own. The shares add up to at
/// most the section's capacity; lowering one never moves a student — the
/// screen shows the overflow and the admin decides.
model SectionStream {
  id        String   @id @default(cuid())
  schoolId  String
  sectionId String
  streamId  String
  capacity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [schoolId, sectionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  stream  Stream  @relation(fields: [schoolId, streamId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([schoolId, id])
  @@unique([schoolId, sectionId, streamId])
  @@index([schoolId, streamId])
}

/// A concrete cohort: Class 11 "A" (Science) in the 2026-27 session.
///
/// Sections are scoped to an academic session, so "Class 10-A" in 2025-26 and
/// in 2026-27 are different rows holding different students.
model Section {
  id                String   @id @default(cuid())
  schoolId          String
  academicSessionId String
  classId           String
  streamId          String?
  name              String
  capacity          Int?
  classTeacherId    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  school          School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSession AcademicSession @relation(fields: [schoolId, academicSessionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  class           Class           @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  stream          Stream?         @relation(fields: [schoolId, streamId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  classTeacher    Teacher?        @relation("SectionClassTeacher", fields: [schoolId, classTeacherId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)

  enrollments         StudentEnrollment[]
  teacherAssignments  TeacherSubjectAssignment[]
  timetableSlots      TimetableSlot[]
  studentAttendance   StudentAttendance[]
  homework            Homework[]
  assessments         Assessment[]
  exams               Exam[]
  notices             Notice[]
  classTeacherHistory ClassTeacherAssignment[]
  meetingSections     MeetingSection[]
  streamAllocations   SectionStream[]
  concerns            SupportConcern[]
  studentLeaves       StudentLeave[]

  supports StudentSupport[]

  attendanceRegisters  AttendanceRegister[]
  registerCovers       RegisterCover[]
  admissionAssignments AdmissionAssignment[]

  @@unique([schoolId, id])
  @@unique([schoolId, academicSessionId, classId, name])
  @@index([schoolId, academicSessionId])
  @@index([schoolId, classId])
}

model Subject {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  code      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacherAssignments TeacherSubjectAssignment[]
  timetableSlots     TimetableSlot[]
  homework           Homework[]
  studentRemarks     StudentRemark[]
  assessments        Assessment[]

  supports        StudentSupport[]
  supportConcerns SupportConcern[]

  @@unique([schoolId, id])
  @@unique([schoolId, code])
  @@index([schoolId, name])
}

/// Staff profile. The login identity lives on `User`; this holds the
/// employment record.
model Teacher {
  id            String        @id @default(cuid())
  schoolId      String
  school        School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId    String
  firstName     String
  lastName      String
  email         String?
  phone         String?
  gender        Gender?
  dateOfBirth   DateTime?     @db.Date
  qualification String?
  /// What the school calls this post — "Senior Teacher", "Head of Science".
  designation   String?
  addressLine   String?
  city          String?
  state         String?
  postalCode    String?
  joiningDate   DateTime?     @db.Date
  photoUrl      String?
  status        TeacherStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  assignments            TeacherSubjectAssignment[]
  timetableSlots         TimetableSlot[]
  classTeacherOf         Section[]                  @relation("SectionClassTeacher")
  classTeacherHistory    ClassTeacherAssignment[]
  salaries               TeacherSalary[]
  salaryPayments         SalaryPayment[]
  attendance             TeacherAttendance[]
  scheduledClassSessions ClassSession[]             @relation("ClassSessionScheduledTeacher")
  actualClassSessions    ClassSession[]             @relation("ClassSessionActualTeacher")
  homework               Homework[]
  studentRemarks         StudentRemark[]
  assessments            Assessment[]
  leaveRequests          LeaveRequest[]
  bookIssues             BookIssue[]
  statusChanges          StatusChange[]
  supports               StudentSupport[]
  supportConcerns        SupportConcern[]

  registerCovers       RegisterCover[]
  admissionAssignments AdmissionAssignment[]

  @@unique([schoolId, id])
  @@unique([schoolId, employeeId])
  @@index([schoolId, status])
  @@index([schoolId, lastName])
}

/// Which teacher teaches which subject to which section, in a given session.
///
/// `streamId` narrows it to one stream / group inside the section ("9 – A
/// Science: Physics"); null means the whole section ("9 – A: English").
///
/// This is also the authorization source for teachers: a teacher may mark
/// attendance only for sections that appear here.
model TeacherSubjectAssignment {
  id                String   @id @default(cuid())
  schoolId          String
  academicSessionId String
  teacherId         String
  subjectId         String
  sectionId         String
  streamId          String?
  createdAt         DateTime @default(now())

  school          School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSession AcademicSession @relation(fields: [schoolId, academicSessionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  teacher         Teacher         @relation(fields: [schoolId, teacherId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  subject         Subject         @relation(fields: [schoolId, subjectId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  section         Section         @relation(fields: [schoolId, sectionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  stream          Stream?         @relation(fields: [schoolId, streamId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([schoolId, id])
  /// Postgres treats NULL streams as distinct, so the whole-section case is
  /// also checked by the application before insert.
  @@unique([schoolId, academicSessionId, teacherId, subjectId, sectionId, streamId])
  @@index([schoolId, teacherId, academicSessionId])
  @@index([schoolId, sectionId])
}

/// A child, as a person. Deliberately holds NO class or section.
///
/// Placement changes every year and lives in `StudentEnrollment`; storing it
/// here would mean promoting a child from Class 9 to Class 10 erases the
/// record of them ever having been in Class 9.
model Student {
  id                    String         @id @default(cuid())
  schoolId              String
  school                School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  /// Null until the school issues portal credentials.
  userId                String?        @unique
  user                  User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  admissionType         AdmissionType?
  admissionNumber       String
  firstName             String
  lastName              String
  dateOfBirth           DateTime?      @db.Date
  gender                Gender?
  photoUrl              String?
  status                StudentStatus  @default(ACTIVE)
  admissionDate         DateTime?      @db.Date
  addressLine           String?
  city                  String?
  state                 String?
  postalCode            String?
  emergencyContactName  String?
  emergencyContactPhone String?
  bloodGroup            String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  enrollments          StudentEnrollment[]
  parents              ParentStudent[]
  noticeRecipients     NoticeRecipient[]
  attendance           StudentAttendance[]
  remarks              StudentRemark[]
  assessmentResults    AssessmentResult[]
  feeCharges           FeeCharge[]
  feePayments          FeePayment[]
  admissionApplication AdmissionApplication?
  enquiryChild         EnquiryChild?
  meetingInvites       MeetingStudent[]
  ptmFamilies          PtmFamily[]
  statusChanges        StatusChange[]
  supports             StudentSupport[]
  supportConcerns      SupportConcern[]
  complaints           Complaint[]
  transport            StudentTransport?
  tripLogs             TransportTripLog[]
  bookIssues           BookIssue[]
  leaves               StudentLeave[]

  /// Optional contact for Classes 6–12 only; never collected for Nursery–5.
  email String?
  phone String?

  feeCarryForwards FeeCarryForward[]

  @@unique([schoolId, id])
  @@unique([schoolId, admissionNumber])
  @@index([schoolId, status])
  @@index([schoolId, lastName])
  @@index([schoolId, firstName])
}

/// One student's placement for one academic session.
///
/// This is the table that keeps history intact: promotion inserts a new row
/// rather than overwriting the old one, so last year's attendance still
/// resolves to last year's class.
model StudentEnrollment {
  id                String           @id @default(cuid())
  schoolId          String
  studentId         String
  academicSessionId String
  classId           String
  sectionId         String
  streamId          String?
  rollNumber        String?
  status            EnrollmentStatus @default(ACTIVE)
  enrolledOn        DateTime         @default(now()) @db.Date
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  school          School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student         Student         @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  academicSession AcademicSession @relation(fields: [schoolId, academicSessionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  class           Class           @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  section         Section         @relation(fields: [schoolId, sectionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  stream          Stream?         @relation(fields: [schoolId, streamId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([schoolId, id])
  /// A student is placed exactly once per session.
  @@unique([schoolId, studentId, academicSessionId])
  /// Roll numbers are unique within a section, per session.
  @@unique([schoolId, academicSessionId, sectionId, rollNumber])
  @@index([schoolId, academicSessionId, sectionId])
  @@index([schoolId, academicSessionId, classId])
  @@index([schoolId, studentId])
}

/// A guardian. One parent row can be linked to any number of children through
/// `ParentStudent`, so siblings never duplicate the parent record.
model Parent {
  id             String    @id @default(cuid())
  schoolId       String
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId         String?   @unique
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName      String
  lastName       String
  email          String?
  phone          String
  occupation     String?
  addressLine    String?
  /// Filled in by the office or by the parent themselves (My account).
  alternatePhone String?
  city           String?
  state          String?
  postalCode     String?
  /// The last time the parent corrected their own details — shown to the office.
  selfUpdatedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  children        ParentStudent[]
  statusChanges   StatusChange[]
  supportConcerns SupportConcern[]

  /// Sensitive: School Admin only. The document itself is a later step.
  idProofType   String?
  idProofNumber String?

  /// Archived: kept for history (their children's records point here), hidden from lists, no login.
  archivedAt DateTime?

  familyPayments FamilyPayment[]
  enquiries      Enquiry[]

  @@unique([schoolId, id])
  @@index([schoolId, phone])
  @@index([schoolId, lastName])
}

/// Join table between guardians and children.
model ParentStudent {
  id           String             @id @default(cuid())
  schoolId     String
  parentId     String
  studentId    String
  relationship ParentRelationship
  /// The guardian contacted first; at most one per student is enforced by the
  /// application when saving.
  isPrimary    Boolean            @default(false)
  createdAt    DateTime           @default(now())

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parent  Parent  @relation(fields: [schoolId, parentId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  student Student @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([schoolId, id])
  @@unique([schoolId, parentId, studentId])
  @@index([schoolId, studentId])
  @@index([schoolId, parentId])
}

/// One recurring period in the weekly timetable.
///
/// Times are minutes from midnight rather than DateTime: a period is a
/// wall-clock slot with no date and no timezone, and integers make ordering
/// and overlap checks straightforward.
model TimetableSlot {
  id                String    @id @default(cuid())
  schoolId          String
  academicSessionId String
  sectionId         String
  subjectId         String
  teacherId         String
  dayOfWeek         DayOfWeek
  startMinute       Int
  endMinute         Int
  /// The room's name as shown on every timetable — kept in step with
  /// `assignedRoom` (renaming a room renames it here too). Clashes are checked
  /// on `roomId`, never on this text.
  room              String?
  roomId            String?
  /// Set when the period is for one stream of a section that shares streams
  /// (11-A Science Physics while Commerce has Accountancy). Null: the whole
  /// section — every period before streams were timetabled.
  streamId          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  school          School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  stream          Stream?         @relation(fields: [schoolId, streamId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  assignedRoom    Room?           @relation(fields: [schoolId, roomId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  academicSession AcademicSession @relation(fields: [schoolId, academicSessionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  section         Section         @relation(fields: [schoolId, sectionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  subject         Subject         @relation(fields: [schoolId, subjectId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  teacher         Teacher         @relation(fields: [schoolId, teacherId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)

  classSessions ClassSession[]

  @@unique([schoolId, id])
  /// A section (or one of its streams) cannot have two lessons starting at the
  /// same moment. Streams of one section may run side by side; a stream period
  /// against a whole-section period is refused in the application layer,
  /// under the section's row lock.
  @@unique([schoolId, academicSessionId, sectionId, streamId, dayOfWeek, startMinute])
  /// Nor can a teacher be in two rooms at once. These catch exact collisions;
  /// partially overlapping periods are rejected in the application layer.
  @@unique([schoolId, academicSessionId, teacherId, dayOfWeek, startMinute])
  @@index([schoolId, academicSessionId, sectionId, dayOfWeek])
  @@index([schoolId, academicSessionId, teacherId, dayOfWeek])
  @@index([schoolId, academicSessionId, roomId, dayOfWeek])
}

enum RoomType {
  CLASSROOM
  LAB
  COMPUTER_LAB
  LIBRARY
  HALL
  STAFF_ROOM
  SPORTS
  ACTIVITY
  OTHER
}

/// A physical room the school can timetable lessons into.
///
/// Rooms are never tied to a class: a period in the timetable picks its room,
/// so the same lab serves many sections. A room used by any period — this
/// session or an earlier one — can be deactivated but not deleted.
model Room {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  /// `name` trimmed and lower-cased, so "Lab 1" and " lab 1 " are one room.
  nameKey     String
  type        RoomType @default(CLASSROOM)
  capacity    Int?
  building    String?
  floor       String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  timetableSlots TimetableSlot[]

  @@unique([schoolId, id])
  @@unique([schoolId, nameKey])
  @@index([schoolId, isActive])
}

/// A timetabled period on a specific date — and the teacher's record of what
/// happened in it.
///
/// This is the "class activity" a teacher fills in after a lesson. It carries
/// no class, section, subject or academic session of its own: every one of
/// those is reached through `timetableSlot`, which already holds them and is
/// the same row the timetable is drawn from. Copying them here would let a
/// lesson's record drift from the lesson.
///
/// It is also the hook for the product's original problem — substitute
/// teachers, remote classes and missed-class recovery all hang off this row.
model ClassSession {
  id                 String             @id @default(cuid())
  schoolId           String
  timetableSlotId    String
  date               DateTime           @db.Date
  status             ClassSessionStatus @default(SCHEDULED)
  scheduledTeacherId String
  actualTeacherId    String?
  /// What was taught. Short, and the one field a parent report would quote.
  topic              String?
  /// Anything longer the teacher wants on the record.
  notes              String?
  /// What the teacher intends to cover, set before the class rather than after.
  /// A row with this and `status = SCHEDULED` is a planned lesson; the same row
  /// becomes the record of it once the teacher writes it up, which is why there
  /// is no separate lesson-plan table.
  plannedTopic       String?
  /// What students should do before the class. The one field that makes an
  /// upcoming lesson actionable rather than just announced.
  preparation        String?
  /// The short list a student revises from — "practice questions 1-10".
  importantPoints    String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  school           School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  timetableSlot    TimetableSlot @relation(fields: [schoolId, timetableSlotId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  scheduledTeacher Teacher       @relation("ClassSessionScheduledTeacher", fields: [schoolId, scheduledTeacherId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  actualTeacher    Teacher?      @relation("ClassSessionActualTeacher", fields: [schoolId, actualTeacherId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)

  materials LessonMaterial[]
  homework  Homework[]

  @@unique([schoolId, id])
  /// One record per period per day: a teacher saving twice edits the first
  /// record rather than creating a second one.
  @@unique([schoolId, timetableSlotId, date])
  @@index([schoolId, date, status])
  /// "My recent classes", which is how a teacher reads this table.
  @@index([schoolId, scheduledTeacherId, date])
}

/// Daily attendance for one student.
///
/// One record per student per day. Period-level attendance would hang off
/// `ClassSession` instead; daily is what schools actually operate on in V1.
/// One section's daily register on one day: the draft while it is being
/// taken, and when and by whom it became the official record. The marks
/// themselves live in `StudentAttendance`, written when the register is
/// submitted — so parents, reports and alerts only ever see submitted marks.
model AttendanceRegister {
  id                 String         @id @default(cuid())
  schoolId           String
  academicSessionId  String
  sectionId          String
  date               DateTime       @db.Date
  status             RegisterStatus @default(DRAFT)
  /// `{ [studentId]: { status, remarks } }` while a draft; cleared on submit.
  draft              Json?
  draftSavedAt       DateTime?
  /// AUTO schools: when the draft submits itself (end of the attendance period).
  finalizeAt         DateTime?
  submittedAt        DateTime?
  /// Null when the draft submitted itself.
  submittedById      String?
  autoSubmitted      Boolean        @default(false)
  /// min(submittedAt + 2 hours, end of `date`), fixed when submitted.
  correctionDeadline DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  school          School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSession AcademicSession @relation(fields: [schoolId, academicSessionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  section         Section         @relation(fields: [schoolId, sectionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  submittedBy     User?           @relation("RegisterSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)

  @@unique([schoolId, id])
  @@unique([schoolId, sectionId, date])
  @@index([schoolId, status, finalizeAt])
}

/// On one day, another teacher takes a section's register — usually because
/// its class teacher is away. Set by the School Admin; gives access for that
/// date only.
model RegisterCover {
  id           String   @id @default(cuid())
  schoolId     String
  sectionId    String
  date         DateTime @db.Date
  teacherId    String
  reason       String?
  assignedById String?
  createdAt    DateTime @default(now())

  school     School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section    Section @relation(fields: [schoolId, sectionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  teacher    Teacher @relation(fields: [schoolId, teacherId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  assignedBy User?   @relation("RegisterCoverAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([schoolId, id])
  @@unique([schoolId, sectionId, date])
  @@index([schoolId, teacherId, date])
}

/// A non-teaching staff member's work handed to a colleague for one day.
model WorkCover {
  id                  String   @id @default(cuid())
  schoolId            String
  date                DateTime @db.Date
  absentStaffMemberId String
  coverStaffMemberId  String
  /// What the colleague should do, in the office's words.
  duties              String
  assignedById        String?
  createdAt           DateTime @default(now())

  school      School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  absentStaff StaffMember @relation("WorkCoverAbsent", fields: [schoolId, absentStaffMemberId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  coverStaff  StaffMember @relation("WorkCoverCover", fields: [schoolId, coverStaffMemberId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  assignedBy  User?       @relation("WorkCoverAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([schoolId, id])
  @@unique([schoolId, date, absentStaffMemberId, coverStaffMemberId])
  @@index([schoolId, coverStaffMemberId, date])
}

model StudentAttendance {
  id                String           @id @default(cuid())
  schoolId          String
  academicSessionId String
  studentId         String
  sectionId         String
  date              DateTime         @db.Date
  status            AttendanceStatus
  remarks           String?
  markedByUserId    String?
  markedAt          DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  school          School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSession AcademicSession @relation(fields: [schoolId, academicSessionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  student         Student         @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  section         Section         @relation(fields: [schoolId, sectionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  markedBy        User?           @relation("AttendanceMarker", fields: [markedByUserId], references: [id], onDelete: SetNull)

  @@unique([schoolId, id])
  /// Prevents double-marking the same student on the same day.
  @@unique([schoolId, studentId, date])
  @@index([schoolId, sectionId, date])
  @@index([schoolId, academicSessionId, date])
  @@index([schoolId, date, status])
}

/// Daily staff attendance. GPS and geofencing are out of V1; check-in and
/// check-out times are recorded so they can be added without a schema change.
/// A non-teaching staff member's day in the staff register — the same
/// statuses as teachers', kept apart so the teachers' register (and the cover
/// planning built on it) stays as it is.
model StaffAttendance {
  id             String                  @id @default(cuid())
  schoolId       String
  staffMemberId  String
  date           DateTime                @db.Date
  status         TeacherAttendanceStatus
  remarks        String?
  markedByUserId String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  school      School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staffMember StaffMember @relation(fields: [schoolId, staffMemberId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  markedBy    User?       @relation("StaffAttendanceMarker", fields: [markedByUserId], references: [id], onDelete: SetNull)

  @@unique([schoolId, id])
  @@unique([schoolId, staffMemberId, date])
  @@index([schoolId, date, status])
}

model TeacherAttendance {
  id           String                  @id @default(cuid())
  schoolId     String
  teacherId    String
  date         DateTime                @db.Date
  status       TeacherAttendanceStatus
  checkInTime  DateTime?
  checkOutTime DateTime?
  remarks      String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [schoolId, teacherId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([schoolId, id])
  @@unique([schoolId, teacherId, date])
  @@index([schoolId, date, status])
}

/// Work set for a whole section in one subject.
///
/// Addressed to the section, not to individual students: that is how a
/// teacher actually sets homework, and it keeps one row per assignment
/// instead of one per child. Per-student submission and marking would be a
/// separate table hanging off this one.
model Homework {
  id                String         @id @default(cuid())
  schoolId          String
  academicSessionId String
  sectionId         String
  subjectId         String
  /// Who set it. Also decides who may edit it.
  teacherId         String
  /// One stream of a section that shares streams; null is the whole section.
  streamId          String?
  /// The class this was set in, when it was set from the class record.
  classSessionId    String?
  title             String
  description       String?
  /// What the student has to do, step by step — "Exercise 4.2, Q1-10".
  instructions      String?
  assignedOn        DateTime       @db.Date
  dueOn             DateTime       @db.Date
  status            HomeworkStatus @default(PUBLISHED)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  school          School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  stream          Stream?         @relation(fields: [schoolId, streamId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  academicSession AcademicSession @relation(fields: [schoolId, academicSessionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  section         Section         @relation(fields: [schoolId, sectionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  subject         Subject         @relation(fields: [schoolId, subjectId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  teacher         Teacher         @relation(fields: [schoolId, teacherId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  classSession    ClassSession?   @relation(fields: [schoolId, classSessionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)

  /// Study resources attached to the homework: PDFs, videos, links.
  resources LessonMaterial[]

  @@unique([schoolId, id])
  /// One piece of homework per class record; re-saving the class edits it.
  @@unique([schoolId, classSessionId])
  /// What a section is due to hand in — the query a report would run.
  @@index([schoolId, academicSessionId, sectionId, dueOn])
  /// What this teacher has set, newest first.
  @@index([schoolId, teacherId, assignedOn])
  @@index([schoolId, status, dueOn])
}

/// A teacher's note about one child, for one academic session.
///
/// Deliberately plain text and deliberately attributed: the teacher who wrote
/// a remark is the only one who may change it, and the session scope keeps
/// last year's notes out of this year's report.
model StudentRemark {
  id                String              @id @default(cuid())
  schoolId          String
  academicSessionId String
  studentId         String
  teacherId         String
  /// Which subject prompted it, where that is meaningful.
  subjectId         String?
  /// The three structured bands. All optional: a teacher may answer one, all
  /// three, or none and write only a note. The application requires at least
  /// one of the four to be present, so an empty remark cannot be saved.
  understanding     RemarkLevel?
  homeworkHabit     HomeworkHabit?
  participation     ParticipationLevel?
  /// The teacher's own words. Optional since the bands can stand alone.
  body              String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  school          School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSession AcademicSession @relation(fields: [schoolId, academicSessionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  student         Student         @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  teacher         Teacher         @relation(fields: [schoolId, teacherId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  subject         Subject?        @relation(fields: [schoolId, subjectId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([schoolId, id])
  @@index([schoolId, academicSessionId, studentId])
  @@index([schoolId, teacherId, createdAt])
}

/// One assessment a class sits: a unit test, a term exam, a class quiz.
///
/// Scoped to a section rather than a class so two sections of Class 10 can sit
/// the same paper on different days, which is how schools actually run them.
/// Marks live on `AssessmentResult`, one row per child.
model Assessment {
  id                String   @id @default(cuid())
  schoolId          String
  academicSessionId String
  sectionId         String
  subjectId         String
  /// Who set it. Null once that teacher's record is removed.
  teacherId         String?
  name              String
  date              DateTime @db.Date
  /// The paper's total. Integer: schools mark in whole numbers, and a float
  /// here would invite rounding differences between the two ends of a report.
  maxMarks          Int
  /// Marks needed to pass this paper. Null means the default share of
  /// `maxMarks` (see `src/lib/grades.ts`).
  passMarks         Int?
  /// The exam this paper belongs to. Null for a class test a teacher set on
  /// their own, whose marks are visible as soon as they are entered.
  examId            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  school          School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSession AcademicSession @relation(fields: [schoolId, academicSessionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  section         Section         @relation(fields: [schoolId, sectionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  subject         Subject         @relation(fields: [schoolId, subjectId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  teacher         Teacher?        @relation(fields: [schoolId, teacherId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  exam            Exam?           @relation(fields: [schoolId, examId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)

  results AssessmentResult[]

  /// Set when the test is for one stream of a shared section (e.g. Science only).
  streamId      String?
  description   String?
  marksStatus   AssessmentMarksStatus @default(DRAFT)
  submittedAt   DateTime?
  submittedById String?
  stream        Stream?               @relation(fields: [schoolId, streamId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([schoolId, id])
  /// One paper per subject per exam.
  @@unique([schoolId, examId, subjectId])
  @@index([schoolId, academicSessionId, sectionId, date])
  @@index([schoolId, subjectId, date])
}

/// Something a teacher attached to one lesson for the class to work from.
///
/// Hung off `ClassSession` rather than off a subject or a section, because the
/// question a student asks is "what did we get for *that* lesson?" — and because
/// the lesson already carries the authorization: only the teacher who may write
/// that period up may attach to it.
///
/// Zero to many per lesson, which is the whole reason this is a table and not
/// three more columns.
model LessonMaterial {
  id             String             @id @default(cuid())
  schoolId       String
  /// Exactly one of `classSessionId` and `homeworkId` is set (a CHECK
  /// constraint enforces it): the same resource system serves a completed
  /// class's materials and a homework's study resources.
  classSessionId String?
  homeworkId     String?
  kind           LessonMaterialKind
  title          String
  /// For LINK, VIDEO and a DOCUMENT hosted elsewhere. `https://` only.
  url            String?
  /// For NOTES, QUESTIONS and PRACTICE: the teacher's own text.
  body           String?
  /// A line under a link or a video saying what it is for.
  description    String?
  /// An uploaded DOCUMENT: where `server/storage/files.ts` keeps the bytes.
  /// Never a path a browser can reach — the file is served only through the
  /// authorized download route, which checks the lesson first.
  storageKey     String?
  fileName       String?
  fileSize       Int?
  mimeType       String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSession ClassSession? @relation(fields: [schoolId, classSessionId], references: [schoolId, id], onDelete: Cascade, onUpdate: NoAction)
  homework     Homework?     @relation(fields: [schoolId, homeworkId], references: [schoolId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([schoolId, id])
  @@index([schoolId, classSessionId])
  @@index([schoolId, homeworkId])
}

/// One child's marks in one assessment.
///
/// `marksObtained` is null for a child who did not sit it — distinct from a
/// zero, which is a mark. The percentage is not stored: it is
/// `marksObtained / assessment.maxMarks`, and storing it would let the two
/// disagree the moment a paper's total is corrected.
model AssessmentResult {
  id            String   @id @default(cuid())
  schoolId      String
  assessmentId  String
  studentId     String
  marksObtained Int?
  /// Did not sit the paper. Always has a null mark; never counted as zero
  /// silently, but fails the paper on a report card.
  absent        Boolean  @default(false)
  /// Excused from this paper (medical, not taking the subject): no mark, and
  /// left out of totals, percentages and pass/fail.
  exempt        Boolean  @default(false)
  /// The teacher's remark on this paper, or the reason there is no mark.
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assessment Assessment @relation(fields: [schoolId, assessmentId], references: [schoolId, id], onDelete: Cascade, onUpdate: NoAction)
  student    Student    @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([schoolId, id])
  /// One result per child per assessment.
  @@unique([schoolId, assessmentId, studentId])
  @@index([schoolId, studentId])
}

/// What a teacher is paid, from a date.
///
/// Effective-dated rather than a column on `Teacher`: a raise is a new row, so
/// what somebody was paid last April survives the change. The current figure is
/// the newest row whose `effectiveFrom` has passed, which is also how a future
/// raise can be entered before it takes effect.
///
/// Money is integer paise, the same convention as `Plan.priceMinor`. A float
/// would let two screens disagree about ₹25,000 by a rounding error.
model TeacherSalary {
  id              String     @id @default(cuid())
  schoolId        String
  /// Exactly one of teacherId / staffMemberId (a database check enforces it):
  /// teachers and non-teaching staff share this salary structure.
  teacherId       String?
  staffMemberId   String?
  salaryType      SalaryType @default(MONTHLY)
  amountMinor     Int
  /// Regular additions — travel, housing. Stored separately so the base figure
  /// stays comparable between staff.
  allowancesMinor Int        @default(0)
  /// Regular subtractions — provident fund, professional tax.
  deductionsMinor Int        @default(0)
  effectiveFrom   DateTime   @db.Date
  notes           String?
  /// Who entered it. Kept so a figure can be traced without reading the log.
  recordedById    String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher     Teacher?     @relation(fields: [schoolId, teacherId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  staffMember StaffMember? @relation(fields: [schoolId, staffMemberId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  recordedBy  User?        @relation("SalaryRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([schoolId, id])
  /// One figure per teacher per effective date; correcting one edits that row.
  @@unique([schoolId, teacherId, effectiveFrom])
  @@unique([schoolId, staffMemberId, effectiveFrom])
  @@index([schoolId, teacherId, effectiveFrom])
}

/// Who was class teacher of a section, and when.
///
/// `Section.classTeacherId` stays the current pointer that the rest of the app
/// reads — this is the history behind it, opened and closed as the office
/// reassigns. Not a duplicate concept: one answers "who is it now" in a single
/// join, the other answers "who was it in August", and collapsing them into one
/// would cost every screen a date filter.
model ClassTeacherAssignment {
  id                String    @id @default(cuid())
  schoolId          String
  academicSessionId String
  sectionId         String
  teacherId         String
  fromDate          DateTime  @db.Date
  /// Null while this is the current assignment.
  toDate            DateTime? @db.Date
  createdAt         DateTime  @default(now())

  school          School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSession AcademicSession @relation(fields: [schoolId, academicSessionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  section         Section         @relation(fields: [schoolId, sectionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  teacher         Teacher         @relation(fields: [schoolId, teacherId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([schoolId, id])
  @@index([schoolId, sectionId, fromDate])
  @@index([schoolId, teacherId, fromDate])
}

/// A kind of fee a school charges. Configurable, because no two schools bill
/// the same things: one has a transport fee, another a lab fee.
model FeeHead {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  /// Shown to parents above the breakdown, where the name alone is not enough.
  note      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school  School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  charges FeeCharge[]

  /// Created by the system (e.g. "Previous outstanding (2025-26)"), never offered in pickers.
  isSystem Boolean @default(false)

  @@unique([schoolId, id])
  @@unique([schoolId, name])
  @@index([schoolId, isActive])
}

/// One amount charged to one student for one session, under one head.
///
/// Per student rather than per class, because that is where a charge actually
/// lands: two children in the same class can owe different transport fees. The
/// admin raises them for a whole class in one action, which writes one row each.
model FeeCharge {
  id                String   @id @default(cuid())
  schoolId          String
  academicSessionId String
  studentId         String
  feeHeadId         String
  amountMinor       Int
  dueOn             DateTime @db.Date
  /// Which instalment of this head (1, 2, 3…). A head paid in one go is
  /// instalment 1, which is every charge created before instalments existed.
  installmentNo     Int      @default(1)
  /// For a late fee: the instalment it was charged on (at most one each).
  lateFeeForId      String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  school          School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSession AcademicSession @relation(fields: [schoolId, academicSessionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  student         Student         @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  feeHead         FeeHead         @relation(fields: [schoolId, feeHeadId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  lateFeeFor      FeeCharge?      @relation("LateFee", fields: [schoolId, lateFeeForId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  lateFee         FeeCharge?      @relation("LateFee")

  concessions      FeeConcession[]
  carriedForwardBy FeeCarryForward[]

  @@unique([schoolId, id])
  /// One charge per head and instalment per student per session; raising it
  /// twice edits the first rather than billing the family twice.
  @@unique([schoolId, academicSessionId, studentId, feeHeadId, installmentNo])
  /// A late fee is charged at most once per instalment.
  @@unique([schoolId, lateFeeForId])
  @@index([schoolId, academicSessionId, studentId])
  @@index([schoolId, academicSessionId, dueOn])
}

/// Money received against one student's fees for one session.
///
/// Deliberately not allocated head by head. Schools take a payment against the
/// account — "₹10,000 towards this year" — and forcing the office to split every
/// receipt across four heads invents work and a new way to be wrong. What is
/// owed is the sum of the charges; what is left is that minus the payments.
model FeePayment {
  id                String        @id @default(cuid())
  schoolId          String
  academicSessionId String
  studentId         String
  amountMinor       Int
  paidOn            DateTime      @db.Date
  method            PaymentMethod @default(CASH)
  /// The school's own receipt number, unique within the school. Fixed once
  /// written: every reprint of the receipt shows this same number.
  receiptNo         String
  /// Cheque number, UPI / bank transaction id — whatever proves the transfer.
  referenceNo       String?
  notes             String?
  /// Who took the payment.
  recordedById      String?
  /// A payment entered by mistake is voided, never deleted: the receipt
  /// number stays on record, marked void, and stops counting as paid.
  voidedAt          DateTime?
  voidedById        String?
  voidReason        String?
  /// Sent with the payment form, once per form: a double submit or a retried
  /// request finds this payment instead of recording it twice.
  idempotencyKey    String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  school          School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSession AcademicSession @relation(fields: [schoolId, academicSessionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  student         Student         @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  recordedBy      User?           @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  voidedBy        User?           @relation("PaymentVoider", fields: [voidedById], references: [id], onDelete: SetNull)

  /// Set when this payment is one child's share of a family payment.
  familyPaymentId String?
  familyPayment   FamilyPayment? @relation(fields: [schoolId, familyPaymentId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([schoolId, id])
  @@unique([schoolId, receiptNo])
  @@unique([schoolId, idempotencyKey])
  @@index([schoolId, academicSessionId, studentId])
  @@index([schoolId, paidOn])
  @@index([schoolId, familyPaymentId])
}

/// A public admission enquiry. Submitted by anyone from the school's public
/// site, so it holds plain contact fields rather than links to User records.
///
/// Accepting an application creates the Student and Parent rows and points
/// `createdStudentId` at the result; nothing is created before the school
/// approves.
model AdmissionApplication {
  id                String          @id @default(cuid())
  schoolId          String
  academicSessionId String
  applicationNumber String
  status            AdmissionStatus @default(SUBMITTED)

  // --- applicant ---
  studentFirstName String
  studentLastName  String
  dateOfBirth      DateTime? @db.Date
  gender           Gender?
  previousSchool   String?

  // --- guardian ---
  parentName         String
  parentRelationship ParentRelationship @default(GUARDIAN)
  parentPhone        String
  parentEmail        String?
  addressLine        String?
  city               String?
  state              String?
  postalCode         String?

  // --- request ---
  requestedClassId  String
  requestedStreamId String?
  notes             String?

  source           AdmissionSource @default(WEBSITE)
  /// Shared by brothers and sisters sent in one public form: each child is
  /// their own application (own number, status and conversion).
  familyKey        String?
  /// Answers to the school's own extra questions: [{ key, label, value }].
  customAnswers    Json?
  archivedAt       DateTime?
  archivedById     String?
  submittedAt      DateTime        @default(now())
  reviewedAt       DateTime?
  reviewedById     String?
  reviewNotes      String?
  createdStudentId String?

  /// Set when a teacher entered it in an admission drive. Moving it to
  /// another assignment (reassigning) keeps the application and its history.
  driveId      String?
  assignmentId String?
  /// The user who entered it (a teacher in a drive); null for public forms.
  createdById  String?

  school          School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSession AcademicSession      @relation(fields: [schoolId, academicSessionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  drive           AdmissionDrive?      @relation(fields: [schoolId, driveId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  assignment      AdmissionAssignment? @relation(fields: [schoolId, assignmentId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  documents       AdmissionDocument[]
  requestedClass  Class                @relation(fields: [schoolId, requestedClassId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  requestedStream Stream?              @relation(fields: [schoolId, requestedStreamId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  reviewedBy      User?                @relation("AdmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdStudent  Student?             @relation(fields: [schoolId, createdStudentId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)

  followUps AdmissionFollowUp[]

  @@unique([schoolId, id])
  @@unique([schoolId, applicationNumber])
  /// Composite, because `createdStudent` is a one-to-one across the tenant key.
  @@unique([schoolId, createdStudentId])
  @@index([schoolId, status, submittedAt])
  @@index([schoolId, academicSessionId])
  @@index([schoolId, parentPhone])
  @@index([schoolId, familyKey])
  @@index([schoolId, assignmentId])
  @@index([schoolId, driveId])
}

/// An admission drive: the School Admin opens admissions for a session
/// between two dates and hands classes / sections to teachers.
model AdmissionDrive {
  id                String               @id @default(cuid())
  schoolId          String
  academicSessionId String
  name              String
  startDate         DateTime             @db.Date
  endDate           DateTime             @db.Date
  status            AdmissionDriveStatus @default(SCHEDULED)
  notes             String?
  createdById       String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  school          School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSession AcademicSession @relation(fields: [schoolId, academicSessionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)

  assignments  AdmissionAssignment[]
  applications AdmissionApplication[]

  @@unique([schoolId, id])
  @@unique([schoolId, academicSessionId, name])
  @@index([schoolId, status])
}

/// One class (or one section of it) in a drive, given to one teacher with
/// their own dates, a capacity and what they may do. Never deleted: a
/// removed assignment keeps `removedAt`, and its applications stay.
model AdmissionAssignment {
  id          String    @id @default(cuid())
  schoolId    String
  driveId     String
  classId     String
  sectionId   String?
  teacherId   String
  startDate   DateTime  @db.Date
  endDate     DateTime  @db.Date
  /// Most applications this assignment may hold (all but rejected ones count).
  capacity    Int
  /// What the teacher may do: view, create, edit, documents, submit.
  permissions String[]
  pausedAt    DateTime?
  removedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  school  School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  drive   AdmissionDrive @relation(fields: [schoolId, driveId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  class   Class          @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  section Section?       @relation(fields: [schoolId, sectionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  teacher Teacher        @relation(fields: [schoolId, teacherId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)

  applications AdmissionApplication[]

  @@unique([schoolId, id])
  @@index([schoolId, driveId])
  @@index([schoolId, teacherId])
}

/// A PDF attached to an application (birth certificate, report card…).
/// Removing one keeps the row with `removedAt`.
model AdmissionDocument {
  id            String    @id @default(cuid())
  schoolId      String
  applicationId String
  label         String
  fileName      String
  storageKey    String
  size          Int
  uploadedById  String?
  createdAt     DateTime  @default(now())
  removedAt     DateTime?

  school      School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  application AdmissionApplication @relation(fields: [schoolId, applicationId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([schoolId, applicationId])
}

/// An announcement. `isPublic` controls whether it also appears on the
/// school's public website; `audience` controls who sees it once signed in.
model Notice {
  id        String         @id @default(cuid())
  schoolId  String
  school    School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title     String
  body      String
  audience  NoticeAudience @default(ALL)
  scope     NoticeScope    @default(SCHOOL)
  kind      NoticeKind     @default(NOTICE)
  /// Set when `scope` is CLASS.
  classId   String?
  /// Set when `scope` is SECTION.
  sectionId String?
  /// Set when `scope` is STREAM.
  streamId  String?
  status    NoticeStatus   @default(DRAFT)
  isPublic  Boolean        @default(false)
  publishAt DateTime?
  expiresAt DateTime?
  authorId  String?
  author    User?          @relation("NoticeAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  class     Class?         @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  section   Section?       @relation(fields: [schoolId, sectionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  stream    Stream?        @relation(fields: [schoolId, streamId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  recipients NoticeRecipient[]
  reads      NoticeRead[]

  @@unique([schoolId, id])
  @@index([schoolId, status, publishAt])
  @@index([schoolId, audience, status])
  @@index([schoolId, isPublic, status])
  @@index([schoolId, kind, status])
}

/// One student a STUDENTS-scoped notice is addressed to.
model NoticeRecipient {
  id        String @id @default(cuid())
  schoolId  String
  noticeId  String
  studentId String

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  notice  Notice  @relation(fields: [schoolId, noticeId], references: [schoolId, id], onDelete: Cascade, onUpdate: NoAction)
  student Student @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([schoolId, id])
  @@unique([schoolId, noticeId, studentId])
  @@index([schoolId, studentId])
}

/// Who has read which notice — the "Unread" badge on the Notices page. A row
/// is written when the person opens or marks the notice read; no row = unread.
model NoticeRead {
  id       String   @id @default(cuid())
  schoolId String
  noticeId String
  userId   String
  readAt   DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  notice Notice @relation(fields: [schoolId, noticeId], references: [schoolId, id], onDelete: Cascade, onUpdate: NoAction)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, id])
  @@unique([schoolId, noticeId, userId])
  @@index([schoolId, userId])
}

model Event {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title       String
  description String?
  date        DateTime @db.Date
  startMinute Int?
  endMinute   Int?
  location    String?
  imageUrl    String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([schoolId, id])
  @@index([schoolId, date])
  @@index([schoolId, isPublished, date])
}

/// A day or run of days the school is closed: Diwali, summer vacation, a
/// rain closure. Both ends are inclusive, so a one-day holiday has
/// `startDate == endDate`.
///
/// Attendance is refused on these days and no attendance row may exist on
/// one: declaring a holiday over days that were already marked requires
/// clearing those marks in the same save. Because every percentage in the app
/// is computed from recorded marks, that single invariant is what keeps a
/// holiday from ever counting as an absence.
model Holiday {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title       String
  description String?
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([schoolId, id])
  @@index([schoolId, startDate])
  @@index([schoolId, endDate])
}

/// A page of the school's public website, edited by the School Admin.
///
/// `body` is stored as plain text/Markdown and rendered through a sanitiser —
/// raw HTML is never accepted, so a school admin cannot inject script into
/// their own public site.
model SchoolPage {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  slug        String
  title       String
  body        String
  isPublished Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([schoolId, id])
  @@unique([schoolId, slug])
  @@index([schoolId, isPublished])
}

/// An uploaded asset (gallery image, banner, logo) held in object storage.
model SchoolMedia {
  id          String        @id @default(cuid())
  schoolId    String
  school      School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  category    MediaCategory @default(GALLERY)
  url         String
  caption     String?
  contentType String?
  sizeBytes   Int?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())

  @@unique([schoolId, id])
  @@index([schoolId, category, sortOrder])
}

/// Money the school spent that is not a salary: the electricity bill, chalk,
/// a bus repair.
///
/// Like `FeePayment`, one row per outgoing amount and no stored totals — every
/// figure on the finance dashboard is a sum over these rows.
model Expense {
  id           String          @id @default(cuid())
  schoolId     String
  category     ExpenseCategory
  description  String
  amountMinor  Int
  spentOn      DateTime        @db.Date
  method       PaymentMethod   @default(CASH)
  /// Bill, invoice or voucher number.
  reference    String?
  notes        String?
  recordedById String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  school     School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  recordedBy User?  @relation("ExpenseRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([schoolId, id])
  @@index([schoolId, spentOn])
  @@index([schoolId, category, spentOn])
}

/// Salary actually paid to a member of staff for one month.
///
/// `TeacherSalary` is what a teacher is owed; this is what left the school's
/// account. Kept apart so a raise does not rewrite a payment already made.
model SalaryPayment {
  id            String        @id @default(cuid())
  schoolId      String
  /// Exactly one of teacherId / staffMemberId (a database check enforces it).
  teacherId     String?
  staffMemberId String?
  amountMinor   Int
  paidOn        DateTime      @db.Date
  /// The first day of the month this payment is for.
  forMonth      DateTime      @db.Date
  method        PaymentMethod @default(BANK_TRANSFER)
  reference     String?
  notes         String?
  recordedById  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher     Teacher?     @relation(fields: [schoolId, teacherId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  staffMember StaffMember? @relation(fields: [schoolId, staffMemberId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  recordedBy  User?        @relation("SalaryPaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([schoolId, id])
  /// One salary payment per teacher per month: paying twice is the mistake
  /// this table exists to prevent.
  @@unique([schoolId, teacherId, forMonth])
  @@unique([schoolId, staffMemberId, forMonth])
  @@index([schoolId, paidOn])
}

enum InquiryTopic {
  DEMO
  PRICING
  ONBOARDING
  SUPPORT
  PARTNERSHIP
  OTHER
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

/// A message from the public contact page to the platform owner.
///
/// Platform-level, like `PlatformOffer`: it belongs to no school, and only a
/// Super Admin can read it. The sender may not have an account at all.
model PlatformInquiry {
  id         String        @id @default(cuid())
  name       String
  schoolName String?
  email      String
  phone      String?
  city       String?
  topic      InquiryTopic  @default(DEMO)
  message    String
  status     InquiryStatus @default(NEW)
  /// Kept for abuse handling only; never shown on a public page.
  ipAddress  String?
  handledAt  DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status, createdAt])
}

enum AccountTokenPurpose {
  ACTIVATION
  PASSWORD_RESET
}

/// A one-time link sent by email: activate an account (choose a password) or
/// reset a forgotten one. Only the SHA-256 of the token is stored.
model AccountToken {
  id          String              @id @default(cuid())
  userId      String
  purpose     AccountTokenPurpose
  tokenHash   String              @unique
  expiresAt   DateTime
  usedAt      DateTime?
  /// Superseded by a newer link, or revoked when the password changed.
  revokedAt   DateTime?
  /// SENT or FAILED, and why — so the school office can resend.
  emailStatus String?
  emailError  String?
  createdById String?
  createdAt   DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

/// The school's admission-number sequence for one year: ADM-2026-00001, …
/// Incremented inside the admission's own transaction, so a failed admission
/// uses no number and two at once never share one.
model AdmissionCounter {
  id       String @id @default(cuid())
  schoolId String
  year     Int
  value    Int    @default(0)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, id])
  @@unique([schoolId, year])
}

enum PhotoOwner {
  STUDENT
  TEACHER
  STAFF
  PARENT
  USER
}

/// A profile photo, stored in the school's private upload area and served
/// only through an authorised route — never a public URL.
model ProfilePhoto {
  id           String     @id @default(cuid())
  schoolId     String
  ownerType    PhotoOwner
  ownerId      String
  storageKey   String
  mimeType     String
  sizeBytes    Int
  uploadedById String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, id])
  @@unique([schoolId, ownerType, ownerId])
}

/// A note on an admission enquiry: a call made, a visit booked, the next step.
model AdmissionFollowUp {
  id             String    @id @default(cuid())
  schoolId       String
  applicationId  String
  note           String
  nextFollowUpOn DateTime? @db.Date
  authorId       String?
  createdAt      DateTime  @default(now())

  school      School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  application AdmissionApplication @relation(fields: [schoolId, applicationId], references: [schoolId, id], onDelete: Cascade, onUpdate: NoAction)
  author      User?                @relation("AdmissionFollowUpAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([schoolId, id])
  @@index([schoolId, applicationId, createdAt])
}

/// A discount on one fee charge. The charge keeps its original amount; the
/// concession says how much comes off, why, and who approved it. Revoking
/// one keeps the row (history) and stops it counting.
model FeeConcession {
  id            String         @id @default(cuid())
  schoolId      String
  feeChargeId   String
  kind          ConcessionKind
  /// FIXED: paise off. PERCENT: basis points (2500 = 25%).
  value         Int
  /// What it came to when approved, for the record. Balances recompute from `value`.
  discountMinor Int
  originalMinor Int
  reason        String
  approvedById  String?
  revokedAt     DateTime?
  revokedById   String?
  revokeReason  String?
  createdAt     DateTime       @default(now())

  school     School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  charge     FeeCharge @relation(fields: [schoolId, feeChargeId], references: [schoolId, id], onDelete: Cascade, onUpdate: NoAction)
  approvedBy User?     @relation("ConcessionApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([schoolId, id])
  @@index([schoolId, feeChargeId])
}

/// One payment at the fee desk covering several siblings. Each child's share
/// is its own `FeePayment` (their accounts never merge); this row ties them
/// together under one family receipt.
model FamilyPayment {
  id                String        @id @default(cuid())
  schoolId          String
  academicSessionId String
  parentId          String
  receiptNo         String
  totalMinor        Int
  paidOn            DateTime      @db.Date
  method            PaymentMethod @default(CASH)
  referenceNo       String?
  notes             String?
  recordedById      String?
  voidedAt          DateTime?
  /// Who voided it (null for family payments voided before this was recorded).
  voidedById        String?
  voidReason        String?
  /// Sent with the form once: a double submit finds this payment instead of taking it twice.
  idempotencyKey    String?
  createdAt         DateTime      @default(now())

  school          School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSession AcademicSession @relation(fields: [schoolId, academicSessionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  parent          Parent          @relation(fields: [schoolId, parentId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  recordedBy      User?           @relation("FamilyPaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  parts           FeePayment[]

  @@unique([schoolId, id])
  @@unique([schoolId, receiptNo])
  @@unique([schoolId, idempotencyKey])
  @@index([schoolId, parentId])
}

/// An earlier session's unpaid balance moved into a later session, as an
/// explicit charge ("Previous outstanding (2025-26)"). The old session then
/// shows that amount as carried forward, not owed twice.
model FeeCarryForward {
  id            String   @id @default(cuid())
  schoolId      String
  studentId     String
  fromSessionId String
  toSessionId   String
  amountMinor   Int
  feeChargeId   String
  createdById   String?
  createdAt     DateTime @default(now())

  school      School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student     Student         @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  fromSession AcademicSession @relation("CarryFrom", fields: [schoolId, fromSessionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  toSession   AcademicSession @relation("CarryTo", fields: [schoolId, toSessionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  charge      FeeCharge       @relation(fields: [schoolId, feeChargeId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  createdBy   User?           @relation("CarryForwardCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([schoolId, id])
  @@unique([schoolId, studentId, fromSessionId])
  @@index([schoolId, toSessionId])
}

// -----------------------------------------------------------------------------
// Family enquiries: a lead, not an admission. One parent, one or more
// children, and the fee the school and family are discussing — never an
// invoice. Nothing financial is created from here without confirmation.
// -----------------------------------------------------------------------------

enum EnquiryStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  CONVERTED
  CLOSED
}

enum EnquirySource {
  WEBSITE
  WALK_IN
  PHONE
  REFERRAL
  OTHER
}

/// A child in an enquiry: still open, admitted as a student, or no longer coming.
enum EnquiryChildStatus {
  OPEN
  ADMITTED
  WITHDRAWN
}

/// A discussed discount: none, a fixed sum, or a percentage.
enum DiscountKind {
  NONE
  FIXED
  PERCENT
}

enum FeeDiscussionStatus {
  NOT_STARTED
  DISCUSSING
  AGREED
}

model Enquiry {
  id                String        @id @default(cuid())
  schoolId          String
  academicSessionId String
  /// ENQ-2026-00015 — separate from APP- (applications) and ADM- (students).
  enquiryNumber     String
  status            EnquiryStatus @default(NEW)
  source            EnquirySource @default(WALK_IN)

  // --- the family contact (one is enough) ---
  parentName       String
  relationship     ParentRelationship @default(GUARDIAN)
  phone            String
  alternatePhone   String?
  email            String?
  addressLine      String?
  city             String?
  state            String?
  postalCode       String?
  /// A parent already at this school, linked so conversion never duplicates them.
  existingParentId String?
  /// Internal notes — never shown publicly.
  notes            String?

  // --- follow-up ---
  nextFollowUpOn  DateTime? @db.Date
  nextAction      String?
  lastContactedAt DateTime?
  assignedToId    String?

  // --- fee discussion (a negotiation record, not a fee) ---
  feeStatus            FeeDiscussionStatus @default(NOT_STARTED)
  familyDiscountKind   DiscountKind        @default(NONE)
  /// FIXED: paise. PERCENT: basis points (1000 = 10%).
  familyDiscountValue  Int                 @default(0)
  familyDiscountMinor  Int                 @default(0)
  familyDiscountReason String?
  /// Internal — never shown publicly.
  discussionNotes      String?
  feeAgreedAt          DateTime?
  feeAgreedById        String?

  closedAt    DateTime?
  closeReason String?
  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  school          School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSession AcademicSession @relation(fields: [schoolId, academicSessionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  existingParent  Parent?         @relation(fields: [schoolId, existingParentId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  assignedTo      User?           @relation("EnquiryAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  feeAgreedBy     User?           @relation("EnquiryFeeAgreer", fields: [feeAgreedById], references: [id], onDelete: SetNull)
  createdBy       User?           @relation("EnquiryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?           @relation("EnquiryUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  children     EnquiryChild[]
  followUps    EnquiryFollowUp[]
  feeRevisions EnquiryFeeRevision[]

  @@unique([schoolId, id])
  @@unique([schoolId, enquiryNumber])
  @@index([schoolId, status, createdAt])
  @@index([schoolId, phone])
  @@index([schoolId, nextFollowUpOn])
}

/// One child in a family enquiry, with their own class, stream and fee discussion.
model EnquiryChild {
  id             String             @id @default(cuid())
  schoolId       String
  enquiryId      String
  position       Int                @default(0)
  status         EnquiryChildStatus @default(OPEN)
  firstName      String
  lastName       String?
  dateOfBirth    DateTime?          @db.Date
  gender         Gender?
  classId        String
  /// Nursery–8: none. 9–10: optional. 11–12: required (see lib/stream-rules.ts).
  streamId       String?
  previousSchool String?
  notes          String?

  // --- fee discussion; originalMinor null means not discussed yet ---
  feeOriginalMinor Int?
  discountKind     DiscountKind @default(NONE)
  /// FIXED: paise. PERCENT: basis points.
  discountValue    Int          @default(0)
  discountMinor    Int          @default(0)
  finalMinor       Int?
  discountReason   String?
  feeNotes         String?
  feeUpdatedAt     DateTime?

  // --- once admitted ---
  convertedStudentId  String?
  convertedAt         DateTime?
  /// When the discussed discount became a real concession (after confirmation).
  concessionAppliedAt DateTime?
  concessionChargeId  String?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school           School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enquiry          Enquiry  @relation(fields: [schoolId, enquiryId], references: [schoolId, id], onDelete: Cascade, onUpdate: NoAction)
  class            Class    @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  stream           Stream?  @relation(fields: [schoolId, streamId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  convertedStudent Student? @relation(fields: [schoolId, convertedStudentId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)
  createdBy        User?    @relation("EnquiryChildCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy        User?    @relation("EnquiryChildUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([schoolId, id])
  @@unique([schoolId, convertedStudentId])
  @@index([schoolId, enquiryId])
  @@index([schoolId, firstName])
}

model EnquiryFollowUp {
  id             String    @id @default(cuid())
  schoolId       String
  enquiryId      String
  note           String
  nextAction     String?
  nextFollowUpOn DateTime? @db.Date
  authorId       String?
  createdAt      DateTime  @default(now())

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enquiry Enquiry @relation(fields: [schoolId, enquiryId], references: [schoolId, id], onDelete: Cascade, onUpdate: NoAction)
  author  User?   @relation("EnquiryFollowUpAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([schoolId, id])
  @@index([schoolId, enquiryId, createdAt])
}

/// Every change to a discussed fee or discount, so the original figures are
/// never lost. `childId` is null for the family discount; it is a plain
/// column (no key) so a removed child's history stays.
model EnquiryFeeRevision {
  id            String       @id @default(cuid())
  schoolId      String
  enquiryId     String
  childId       String?
  childName     String?
  originalMinor Int
  discountKind  DiscountKind
  discountValue Int
  discountMinor Int
  finalMinor    Int
  reason        String?
  notes         String?
  changedById   String?
  createdAt     DateTime     @default(now())

  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enquiry   Enquiry @relation(fields: [schoolId, enquiryId], references: [schoolId, id], onDelete: Cascade, onUpdate: NoAction)
  changedBy User?   @relation("EnquiryFeeReviser", fields: [changedById], references: [id], onDelete: SetNull)

  @@unique([schoolId, id])
  @@index([schoolId, enquiryId, createdAt])
}

/// The public admission page's settings. School name, logo, address, about
/// and the principal's message come from the website profile; this adds
/// what only admissions need. No row: open all year, every active class.
model AdmissionPortal {
  id           String    @id @default(cuid())
  schoolId     String    @unique
  /// Unpublished: the public form is switched off whatever the dates say.
  /// Existing schools stay published, as before.
  isPublished  Boolean   @default(true)
  opensOn      DateTime? @db.Date
  closesOn     DateTime? @db.Date
  instructions String?
  mapUrl       String?
  websiteUrl   String?
  highlights   String[]  @default([])
  /// Classes open for admission; empty means every active class.
  classIds     String[]  @default([])
  /// The school's own extra questions: [{ key, label, kind, options, required }].
  customFields Json      @default("[]")
  updatedById  String?
  updatedAt    DateTime  @updatedAt

  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  updatedBy User?  @relation("AdmissionPortalEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([schoolId, id])
}

/// Where a visitor stands: inside the campus, left, or turned away at the gate.
enum VisitorStatus {
  INSIDE
  LEFT
  DENIED
}

/// One visit at the gate: who, why, whom they came to meet, when they came in
/// and left. Corrections are audited; a visit is never deleted.
model Visitor {
  id           String        @id @default(cuid())
  schoolId     String
  name         String
  phone        String
  purpose      String
  /// Whom they came to meet — a name or an office, as told at the gate.
  personToMeet String
  vehicleNo    String?
  entryAt      DateTime
  exitAt       DateTime?
  status       VisitorStatus @default(INSIDE)
  notes        String?
  recordedById String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  school     School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  recordedBy User?  @relation("VisitorRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([schoolId, id])
  @@index([schoolId, entryAt])
  @@index([schoolId, status])
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  VOLUNTEER
}

enum StaffDocumentType {
  AADHAAR
  PAN
  QUALIFICATION
  EXPERIENCE
  PREVIOUS_EMPLOYMENT
  APPOINTMENT_LETTER
  JOINING
  OTHER
}

enum DocumentVerification {
  PENDING
  VERIFIED
  REJECTED
}

/// A document kept on a staff member's record (Aadhaar, certificates,
/// appointment letter…). Stored privately; only the School Admin of the same
/// school reads it. Never deleted — archiving keeps the row and the history.
model StaffDocument {
  id            String               @id @default(cuid())
  schoolId      String
  staffMemberId String
  type          StaffDocumentType
  /// What the admin called it ("B.Ed. certificate").
  label         String?
  fileName      String
  mimeType      String
  size          Int
  storageKey    String
  verification  DocumentVerification @default(PENDING)
  notes         String?
  uploadedById  String?
  createdAt     DateTime             @default(now())
  archivedAt    DateTime?
  archivedById  String?

  school      School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staffMember StaffMember @relation(fields: [schoolId, staffMemberId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([schoolId, id])
  @@index([schoolId, staffMemberId])
}

enum ResponsibilityStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  /// Kept for reports; a live record is "overdue" when its end date has passed and it is not done.
  OVERDUE
  CANCELLED
}

enum ResponsibilityPriority {
  LOW
  NORMAL
  HIGH
}

/// A duty the Principal (or School Admin) hands to a teacher or staff member —
/// exam coordinator, PTM coordinator, sports in-charge… It is a record of work,
/// never a permission: holding one grants no access of its own.
model Responsibility {
  id           String                 @id @default(cuid())
  schoolId     String
  title        String
  description  String?
  /// A key from RESPONSIBILITY_TYPES in lib/responsibilities.ts.
  type         String
  assignedToId String
  assignedById String?
  startDate    DateTime               @db.Date
  endDate      DateTime?              @db.Date
  status       ResponsibilityStatus   @default(PENDING)
  priority     ResponsibilityPriority @default(NORMAL)
  /// The assigner's notes.
  notes        String?
  /// The assignee's latest progress update.
  progressNote String?
  completedAt  DateTime?
  /// Set when the assigner reviews completed work and confirms it.
  confirmedAt  DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  school     School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignedTo User   @relation("ResponsibilityAssignee", fields: [assignedToId], references: [id], onDelete: Cascade)
  assignedBy User?  @relation("ResponsibilityAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([schoolId, id])
  @@index([schoolId, status])
  @@index([schoolId, assignedToId])
}

/// An Owner/Management group running one or more campuses. A campus is a
/// complete, independently managed school (`School`) — its students, staff,
/// academics and money stay its own; the organization only groups them.
model Organization {
  id                  String   @id @default(cuid())
  name                String
  /// The owner: a School Admin who may switch between this organization's
  /// campuses and see a summary across them. Never a platform role.
  ownerId             String?  @unique
  /// Set by the Super Admin to override the plan's campus limit.
  campusLimitOverride Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  owner           User?            @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  schools         School[]
  requests        CampusRequest[]
  featureRequests FeatureRequest[]
}

/// A school owner's request for something SchoolOS does not do yet. Reviewed
/// by the Super Admin; cost, scope and timeline are agreed before work starts.
model FeatureRequest {
  id              String                 @id @default(cuid())
  organizationId  String
  /// The campus it is for (any campus of the organization), if one.
  schoolId        String?
  requestedById   String?
  title           String
  problem         String
  description     String
  expectedOutcome String?
  /// A module key (core or optional) it relates to, if any.
  moduleKey       String?
  priority        FeatureRequestPriority @default(MEDIUM)
  examples        String?
  status          FeatureRequestStatus   @default(SUBMITTED)

  estimatedTimeline  String?
  estimatedCostMinor Int?
  costAgreed         Boolean              @default(false)
  /// Customer-specific vs product-wide is the Super Admin's call.
  potentialStandard  Boolean              @default(false)
  releaseScope       FeatureReleaseScope?
  /// Plans and organizations eligible after release (ids), per the scope.
  eligiblePlanIds    String[]             @default([])
  eligibleOrgIds     String[]             @default([])
  releaseNote        String?
  approvedById       String?
  approvedAt         DateTime?
  developedBy        String?
  testedBy           String?
  releasedById       String?
  releasedAt         DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school       School?               @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  requestedBy  User?                 @relation("FeatureRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  events       FeatureRequestEvent[]

  @@index([organizationId, createdAt])
  @@index([status, createdAt])
}

/// The history and discussion of a feature request. `internal` notes are the
/// Super Admin's own and never shown to the school.
model FeatureRequestEvent {
  id         String                @id @default(cuid())
  requestId  String
  actorId    String?
  fromStatus FeatureRequestStatus?
  toStatus   FeatureRequestStatus?
  body       String?
  internal   Boolean               @default(false)
  createdAt  DateTime              @default(now())

  request FeatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User?          @relation("FeatureRequestActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
}

enum CampusRequestStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  /// Approved with changes by the Super Admin.
  MODIFIED
}

/// A request to open another campus. Never creates anything by itself: the
/// Super Admin approves (as asked, or modified) or rejects it. The requested
/// configuration is kept as asked; the approved one is stored beside it.
model CampusRequest {
  id             String              @id @default(cuid())
  organizationId String
  /// The campus the request was made from.
  fromSchoolId   String?
  requestedById  String?
  status         CampusRequestStatus @default(PENDING)

  name             String
  addressLine      String?
  city             String
  state            String
  postalCode       String?
  contactName      String
  contactEmail     String
  contactPhone     String
  affiliationBoard String?
  expectedStudents Int?
  expectedTeachers Int?
  expectedStaff    Int?
  notes            String?

  requestedModules    String[]
  requestedRoles      String[]
  requestedLimits     Json           @default("{}")
  /// What the request asks for beyond the organization's plan at the time
  /// (campus limit, modules, roles, limits) — shown to the Super Admin.
  /// Asking is always allowed; activation needs the entitlement.
  entitlementNotes    String[]       @default([])
  approvedModules     String[]
  approvedRoles       String[]
  approvedLimits      Json?
  /// The extra-campus fee quoted when the request was made (beyond the
  /// plan's included campuses), so the Super Admin sees what was shown.
  /// A quote only — nothing is charged by SchoolOS.
  quotedExtraFeeMinor Int?
  quotedExtraPeriod   BillingPeriod?

  reviewedById    String?
  reviewedAt      DateTime?
  reviewNote      String?
  rejectionReason String?
  createdSchoolId String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromSchool    School?      @relation("CampusRequestFromSchool", fields: [fromSchoolId], references: [id], onDelete: SetNull)
  createdSchool School?      @relation("CampusRequestCreatedSchool", fields: [createdSchoolId], references: [id], onDelete: SetNull)
  requestedBy   User?        @relation("CampusRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  reviewedBy    User?        @relation("CampusReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([status, createdAt])
}

enum PlanChangeStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// A School Admin asking to move to another plan. Online payment is not part
/// of SchoolOS yet, so nothing changes until the Super Admin approves; then
/// the school's subscription moves to the plan (and its modules/roles follow,
/// unless adjusted for the school).
model PlanChangeRequest {
  id              String           @id @default(cuid())
  schoolId        String
  currentPlanId   String?
  requestedPlanId String
  requestedById   String?
  status          PlanChangeStatus @default(PENDING)
  note            String?
  reviewedById    String?
  reviewedAt      DateTime?
  reviewNote      String?
  rejectionReason String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  school        School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  currentPlan   Plan?  @relation("PlanCurrent", fields: [currentPlanId], references: [id], onDelete: SetNull)
  requestedPlan Plan   @relation("PlanRequested", fields: [requestedPlanId], references: [id], onDelete: Restrict)
  requestedBy   User?  @relation("PlanRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  reviewedBy    User?  @relation("PlanReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([schoolId, status])
  @@index([status, createdAt])
}

/// How a session's final result is made from its exams, e.g. "Unit Test 1"
/// 10% + "Half-Yearly" 30% + "Annual" 60%. Each component is an exam name
/// (exams are created per section under one name). For every subject, each
/// exam's percentage is weighted — never raw marks added across different
/// maximums. Components must total 100.
model ResultScheme {
  id                String   @id @default(cuid())
  schoolId          String
  academicSessionId String
  name              String
  /// [{"examName": "Half-Yearly", "weight": 30}, …], weights in whole percent.
  components        Json
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  school          School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSession AcademicSession @relation(fields: [schoolId, academicSessionId], references: [schoolId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([schoolId, id])
  /// One final-result scheme per session.
  @@unique([schoolId, academicSessionId])
}
